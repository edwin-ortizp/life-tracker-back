{#
  Mapa del vehículo para planes de mantenimiento: vista lateral y vista superior (capó abierto).
  Cada pieza interactiva es un <g class="lt-cz" data-zone> con el tono del plan más urgente:
  ok (al día), soon (vence pronto), over (vencido) o none (sin plan). Los ids de zona se comparten
  entre vistas, etiquetas (callouts), chips de documentos/otros sistemas y filas del "Plan de cuidados".
  tones: dict zona → tono. Dibujo propio, sin recursos de terceros.
#}
{% macro zone(id, label, tones) %}<g class="lt-cz lt-tone-{{ tones.get(id, 'none') }}" data-zone="{{ id }}" data-label="{{ label }}" tabindex="0" role="button" aria-label="{{ label }}">{{ caller() }}</g>{% endmacro %}

{# Etiqueta con línea guía; solo se dibuja para zonas que tienen plan. #}
{% macro callout(id, label, text, tones, ax, ay, lx, ly) %}{% if id in tones %}{% set w = text|length * 6 + 26 %}<g class="lt-cz-callout lt-tone-{{ tones[id] }}" data-zone="{{ id }}" data-label="{{ label }}"><path d="M{{ ax }} {{ ay }}L{{ lx }} {{ ly }}"/><circle class="lt-cz-callout__anchor" cx="{{ ax }}" cy="{{ ay }}" r="3"/><rect x="{{ lx - w / 2 }}" y="{{ ly - 11 }}" width="{{ w }}" height="22" rx="11"/><circle class="lt-cz-callout__dot" cx="{{ lx - w / 2 + 11 }}" cy="{{ ly }}" r="4"/><text x="{{ lx - w / 2 + 20 }}" y="{{ ly + 4 }}">{{ text }}</text></g>{% endif %}{% endmacro %}

{% macro vehicle_side(tones) %}
<svg class="lt-car-svg" data-car-side="side" viewBox="0 0 540 256" role="group" aria-label="Vista lateral del vehículo">
  <defs>
    <linearGradient id="lt-car-paint-side" x1="0" y1="0" x2="0" y2="1"><stop class="lt-car-stop-a" offset="0"/><stop class="lt-car-stop-b" offset="1"/></linearGradient>
    <linearGradient id="lt-car-glass-side" x1="0" y1="0" x2="1" y2="1"><stop class="lt-car-glass-a" offset="0"/><stop class="lt-car-glass-b" offset="1"/></linearGradient>
  </defs>
  <ellipse class="lt-car-shadow" cx="264" cy="222" rx="236" ry="9"/>
  <path class="lt-car-ground" d="M16 222H524"/>

  {% call zone('body', 'Carrocería', tones) %}
    <path class="lt-cz-shape lt-cz-shape--paint" d="M44 188L38 160Q36 140 46 130L108 120Q140 92 178 80Q240 72 298 76Q330 80 364 116L462 126Q486 130 492 146L496 176Q496 188 486 188L442 188A42 42 0 0 0 358 188L170 188A42 42 0 0 0 86 188Z"/>
    <path class="lt-car-detail" d="M110 124L462 128M346 112L350 184M228 82L228 184M150 106Q156 150 170 184M172 178L356 178M372 128Q420 132 462 134M470 170L494 170M40 170L66 170"/>
    <rect class="lt-car-fill" x="292" y="134" width="20" height="4" rx="2"/><rect class="lt-car-fill" x="178" y="132" width="18" height="4" rx="2"/>
    <path class="lt-car-fill" d="M338 106L356 104L358 116L344 116Z"/>
    <circle class="lt-car-detail" cx="118" cy="142" r="7"/>
  {% endcall %}

  {% call zone('engine', 'Motor y lubricación', tones) %}
    <rect class="lt-cz-shape lt-cz-shape--ghost" x="376" y="134" width="78" height="40" rx="6"/>
    <path class="lt-car-detail" d="M386 144H444M386 152H444M386 160H444"/>
  {% endcall %}
  {% call zone('transmission', 'Transmisión', tones) %}
    <path class="lt-cz-shape lt-cz-shape--ghost" d="M352 152H374V176H356Q350 176 350 170V158Q350 152 356 152Z"/>
    <path class="lt-car-detail" d="M355 160H370M355 166H370M355 172H370"/>
  {% endcall %}
  {% call zone('cabin', 'Filtro de cabina y A/C', tones) %}
    <rect class="lt-cz-shape lt-cz-shape--ghost" x="318" y="124" width="30" height="24" rx="4"/>
    <circle class="lt-car-detail" cx="333" cy="136" r="7"/><path class="lt-car-detail" d="M333 129V143M326 136H340"/>
  {% endcall %}
  {% call zone('suspension', 'Suspensión', tones) %}
    {% for cx in [128, 400] %}
    <rect class="lt-cz-shape lt-cz-shape--ghost" x="{{ cx - 5 }}" y="118" width="10" height="42" rx="3"/>
    <path class="lt-car-detail" d="M{{ cx - 11 }} 126l22 5l-22 5l22 5l-22 5l22 5l-22 5"/>
    {% endfor %}
  {% endcall %}

  {% call zone('glass', 'Vidrios y plumillas', tones) %}
    <path class="lt-cz-shape lt-cz-shape--glass" d="M234 86L296 84Q322 90 346 114L234 118Z"/>
    <path class="lt-cz-shape lt-cz-shape--glass" d="M184 88L222 86L222 118L122 120Q150 98 184 88Z"/>
    <path class="lt-cz-shape lt-cz-shape--glass" d="M302 78Q336 86 364 116L354 116Q330 92 300 82Z"/>
    <path class="lt-car-detail lt-car-detail--light" d="M252 112L274 90M158 114L178 96"/>
    <path class="lt-car-detail" d="M350 118L374 110"/>
  {% endcall %}

  {% call zone('lights', 'Luces', tones) %}
    <path class="lt-cz-shape lt-cz-shape--lamp" d="M458 130L486 136Q490 142 488 148L462 144Z"/>
    <path class="lt-cz-shape lt-cz-shape--lamp" d="M42 136L70 130L72 146L44 150Z"/>
    <rect class="lt-cz-shape lt-cz-shape--lamp" x="444" y="152" width="12" height="5" rx="2"/>
  {% endcall %}

  {% call zone('exhaust', 'Escape', tones) %}
    <rect class="lt-cz-shape" x="52" y="190" width="46" height="9" rx="4"/><rect class="lt-cz-shape" x="38" y="192" width="16" height="5" rx="2"/>
  {% endcall %}

  {% for cx in [128, 400] %}
  {% call zone('tires', 'Llantas', tones) %}
    <circle class="lt-cz-shape lt-cz-shape--rubber" cx="{{ cx }}" cy="188" r="34"/>
    <circle class="lt-car-rim" cx="{{ cx }}" cy="188" r="23"/>
  {% endcall %}
  {% call zone('brakes', 'Frenos', tones) %}
    <circle class="lt-cz-shape" cx="{{ cx }}" cy="188" r="16"/>
    <path class="lt-cz-shape lt-cz-shape--caliper" d="M{{ cx + 4 }} 169A19 19 0 0 1 {{ cx + 18 }} 180L{{ cx + 11 }} 184A12 12 0 0 0 {{ cx + 2 }} 176Z"/>
  {% endcall %}
  <path class="lt-car-spoke" d="{% for dx, dy in [(0, -1), (0.951, -0.309), (0.588, 0.809), (-0.588, 0.809), (-0.951, -0.309)] %}M{{ cx + dx * 7 }} {{ 188 + dy * 7 }}L{{ cx + dx * 22 }} {{ 188 + dy * 22 }}{% endfor %}"/>
  <circle class="lt-car-rim" cx="{{ cx }}" cy="188" r="5"/>
  {% endfor %}

  {{ callout('suspension', 'Suspensión', 'Suspensión', tones, 128, 140, 100, 26) }}
  {{ callout('glass', 'Vidrios y plumillas', 'Vidrios', tones, 262, 104, 205, 26) }}
  {{ callout('cabin', 'Filtro de cabina y A/C', 'Filtro de cabina', tones, 333, 136, 330, 26) }}
  {{ callout('engine', 'Motor y lubricación', 'Motor', tones, 415, 154, 440, 26) }}
  {{ callout('lights', 'Luces', 'Luces', tones, 474, 140, 505, 70) }}
  {{ callout('exhaust', 'Escape', 'Escape', tones, 60, 196, 50, 244) }}
  {{ callout('tires', 'Llantas', 'Llantas', tones, 128, 218, 140, 244) }}
  {{ callout('body', 'Carrocería', 'Carrocería', tones, 262, 160, 230, 244) }}
  {{ callout('transmission', 'Transmisión', 'Transmisión', tones, 362, 172, 310, 244) }}
  {{ callout('brakes', 'Frenos', 'Frenos', tones, 414, 178, 410, 244) }}
</svg>
{% endmacro %}

{% macro vehicle_top(tones) %}
<svg class="lt-car-svg" data-car-side="top" viewBox="0 0 540 300" role="group" aria-label="Vista superior del vehículo con el capó abierto" hidden>
  <defs>
    <linearGradient id="lt-car-glass-top" x1="0" y1="0" x2="1" y2="1"><stop class="lt-car-glass-a" offset="0"/><stop class="lt-car-glass-b" offset="1"/></linearGradient>
  </defs>

  {% call zone('body', 'Carrocería', tones) %}
    <path class="lt-cz-shape lt-cz-shape--shell" d="M78 96Q76 62 118 58L420 58Q480 62 490 108L490 192Q480 238 420 242L118 242Q76 238 78 204Z"/>
    <rect class="lt-car-detail" x="172" y="84" width="124" height="132" rx="10"/>
    <path class="lt-car-detail lt-car-detail--dash" d="M350 62V238M112 64V236"/>
    <ellipse class="lt-car-fill" cx="332" cy="52" rx="10" ry="5"/><ellipse class="lt-car-fill" cx="332" cy="248" rx="10" ry="5"/>
  {% endcall %}

  {% call zone('glass', 'Vidrios y plumillas', tones) %}
    <path class="lt-cz-shape lt-cz-shape--glass-top" d="M298 84L344 70Q352 150 344 230L298 216Z"/>
    <path class="lt-cz-shape lt-cz-shape--glass-top" d="M170 84L130 72Q122 150 130 228L170 216Z"/>
  {% endcall %}

  <rect class="lt-car-part" x="150" y="104" width="56" height="70" rx="12"/><text class="lt-car-label" x="178" y="142">Tanque</text>

  {% call zone('suspension', 'Suspensión', tones) %}
    <rect class="lt-cz-shape" x="117" y="72" width="6" height="156" rx="3"/>
    {% for cx, cy in [(120, 84), (120, 216), (400, 80), (400, 222)] %}<circle class="lt-cz-shape" cx="{{ cx }}" cy="{{ cy }}" r="7"/>{% endfor %}
  {% endcall %}

  {% call zone('exhaust', 'Escape', tones) %}
    <rect class="lt-cz-shape" x="140" y="198" width="236" height="6" rx="3"/>
    <rect class="lt-cz-shape" x="86" y="190" width="56" height="22" rx="10"/>
    <rect class="lt-cz-shape" x="66" y="196" width="22" height="10" rx="4"/>
  {% endcall %}

  {% call zone('cabin', 'Filtro de cabina y A/C', tones) %}
    <rect class="lt-cz-shape" x="352" y="96" width="16" height="108" rx="4"/>
    <circle class="lt-car-detail" cx="360" cy="150" r="5"/>
  {% endcall %}

  {% call zone('cooling', 'Refrigeración', tones) %}
    <rect class="lt-cz-shape" x="466" y="86" width="12" height="128" rx="3"/>
    <path class="lt-car-detail" d="M466 100H478M466 114H478M466 128H478M466 142H478M466 156H478M466 170H478M466 184H478M466 198H478"/>
    <circle class="lt-cz-shape" cx="456" cy="104" r="7"/>
  {% endcall %}

  {% call zone('engine', 'Motor y lubricación', tones) %}
    <rect class="lt-cz-shape" x="376" y="88" width="70" height="84" rx="8"/>
    <rect class="lt-car-detail" x="388" y="96" width="46" height="68" rx="6"/>
    {% for cy in [108, 124, 140, 156] %}<circle class="lt-car-fill" cx="411" cy="{{ cy }}" r="5"/>{% endfor %}
    <circle class="lt-car-detail" cx="428" cy="102" r="3.5"/>
    <rect class="lt-cz-shape" x="420" y="64" width="36" height="18" rx="4"/><path class="lt-car-detail" d="M426 70H450M426 76H450"/>
    <circle class="lt-cz-shape" cx="453" cy="160" r="6"/>
  {% endcall %}

  {% call zone('transmission', 'Transmisión', tones) %}
    <rect class="lt-cz-shape" x="398" y="64" width="4" height="24" rx="2"/><rect class="lt-cz-shape" x="398" y="210" width="4" height="26" rx="2"/>
    <path class="lt-cz-shape" d="M384 176H432Q440 176 440 184V202Q440 210 432 210H392Q384 210 384 202Z"/>
    <path class="lt-car-detail" d="M392 186H424M392 193H424M392 200H424"/>
    <circle class="lt-car-fill" cx="432" cy="184" r="3"/>
  {% endcall %}

  {% call zone('battery', 'Batería', tones) %}
    <rect class="lt-cz-shape" x="440" y="214" width="26" height="20" rx="3"/>
    <text class="lt-car-label" x="447" y="227">+</text><text class="lt-car-label" x="459" y="227">−</text>
  {% endcall %}

  {% call zone('lights', 'Luces', tones) %}
    <rect class="lt-cz-shape lt-cz-shape--lamp" x="474" y="70" width="12" height="28" rx="5"/><rect class="lt-cz-shape lt-cz-shape--lamp" x="474" y="202" width="12" height="28" rx="5"/>
    <rect class="lt-cz-shape lt-cz-shape--lamp" x="80" y="74" width="8" height="24" rx="3"/><rect class="lt-cz-shape lt-cz-shape--lamp" x="80" y="202" width="8" height="24" rx="3"/>
  {% endcall %}

  {% for x, y in [(92, 40), (92, 236), (372, 40), (372, 236)] %}
  {% call zone('tires', 'Llantas', tones) %}
    <rect class="lt-cz-shape lt-cz-shape--rubber" x="{{ x }}" y="{{ y }}" width="56" height="24" rx="8"/>
    <path class="lt-car-detail lt-car-detail--light" d="{% for i in range(4) %}M{{ x + 12 + i * 11 }} {{ y + 5 }}V{{ y + 19 }}{% endfor %}"/>
  {% endcall %}
  {% call zone('brakes', 'Frenos', tones) %}
    <rect class="lt-cz-shape lt-cz-shape--caliper" x="{{ x + 4 }}" y="{{ y + 24 if y < 100 else y - 8 }}" width="16" height="8" rx="2"/>
  {% endcall %}
  {% endfor %}

  {{ callout('suspension', 'Suspensión', 'Suspensión', tones, 120, 100, 100, 20) }}
  {{ callout('cabin', 'Filtro de cabina y A/C', 'Filtro de cabina', tones, 360, 150, 300, 20) }}
  {{ callout('engine', 'Motor y lubricación', 'Motor', tones, 411, 130, 430, 20) }}
  {{ callout('exhaust', 'Escape', 'Escape', tones, 76, 201, 45, 280) }}
  {{ callout('tires', 'Llantas', 'Llantas', tones, 120, 256, 130, 280) }}
  {{ callout('brakes', 'Frenos', 'Frenos', tones, 104, 230, 215, 280) }}
  {{ callout('transmission', 'Transmisión', 'Transmisión', tones, 412, 193, 305, 280) }}
  {{ callout('battery', 'Batería', 'Batería', tones, 453, 224, 395, 280) }}
  {{ callout('cooling', 'Refrigeración', 'Refrigeración', tones, 472, 190, 486, 280) }}
</svg>
{% endmacro %}
