{% macro list_item(done=false) -%}<div class="lt-list-item" data-ui-component="life-tracker/data/list" data-ui-variant="{{ 'done' if done else 'default' }}"><span class="lt-check{% if done %} is-done{% endif %}">✓</span><div class="lt-list-item__body"><strong>Beber agua</strong><span>Meta diaria · 250 ml</span></div><span class="lt-chip">Hoy</span></div>{%- endmacro %}
{% macro chips() -%}<div data-ui-component="life-tracker/data/list" data-ui-variant="chip" style="display:flex;gap:8px;flex-wrap:wrap"><span class="lt-chip">Hoy</span><span class="lt-chip lt-chip--success">Completado</span><span class="lt-chip">Pendiente</span></div>{%- endmacro %}
{% macro showcase() -%}<div class="lt-page"><div class="lt-list">{{ list_item() }}{{ list_item(true) }}</div>{{ chips() }}</div>{%- endmacro %}
