{% macro field(kind='text') -%}<label class="lt-field" data-ui-component="life-tracker/forms/field" data-ui-variant="{{ kind }}"><span>{% if kind == 'select' %}Prioridad{% elif kind == 'date' %}Fecha{% else %}Título{% endif %}</span>{% if kind == 'select' %}<select><option>Media</option><option>Alta</option></select>{% else %}<input type="{{ kind }}" value="{% if kind == 'text' %}Caminar 30 minutos{% else %}2026-09-11{% endif %}">{% endif %}</label>{%- endmacro %}
{% macro showcase() -%}<div class="lt-form"><div>{{ field() }}</div><div>{{ field('date') }}</div><div>{{ field('select') }}</div></div>{%- endmacro %}
