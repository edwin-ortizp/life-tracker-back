{% from '@project/components/life-shell.html.jinja' import dialog %}
{% macro plan_row(p, menu_id, module=false) -%}
<div class="lt-plan" data-ui-component="life-tracker/data/plan-row" data-ui-variant="{{ p.variant }}">
  <span class="lt-plan__media" aria-hidden="true"><i class="bi {{ p.icon }}"></i></span>
  <div class="lt-plan__body"><strong>{{ p.title }}</strong><span><i class="bi bi-geo-alt" aria-hidden="true"></i> {{ p.city }} · {{ p.type }} · {{ p.category }}</span>{% if p.get('people') %}<span class="lt-plan__people"><i class="bi bi-people" aria-hidden="true"></i>{% for who in p.people %}{% if who.startswith('+') %}<span class="lt-chip lt-chip--neutral">{{ who }}</span>{% elif who in ['Pareja','Familia','Amigos cercanos','Amigos','Trabajo'] %}<span class="lt-chip">{{ who }}</span>{% else %}<span class="lt-plan__person"><span class="lt-avatar">{{ who[:1] }}</span>{{ who }}</span>{% endif %}{% endfor %}</span>{% endif %}</div>
  <div class="lt-plan__meta">
    <div class="lt-plan__line">{% if p.get('date') %}<span class="lt-plan__date"><i class="bi bi-calendar-event" aria-hidden="true"></i> {{ p.date }}</span>{% endif %}<span class="lt-chip lt-chip--{{ p.tone }}">{{ p.status }}</span></div>
    {% if p.get('left') %}<small class="lt-plan__left">{{ p.left }}</small>{% endif %}
    {% if module %}<small class="lt-plan__stats"><i class="bi bi-bar-chart" aria-hidden="true"></i> {{ p.visits }} {{ 'visita' if p.visits == 1 else 'visitas' }}</small><small class="lt-plan__stats"><i class="bi bi-calendar3" aria-hidden="true"></i> Última vez: {{ p.last }}</small>{% else %}<small class="lt-plan__stats"><i class="bi bi-arrow-repeat" aria-hidden="true"></i> Última vez: {{ p.last }}{% if p.visits %} · {{ p.visits }} {{ 'visita' if p.visits == 1 else 'visitas' }}{% endif %}</small>{% endif %}
  </div>
  <div class="lt-menu-anchor"><button class="lt-icon-button" type="button" data-lt-toggle="{{ menu_id }}" aria-haspopup="menu" aria-expanded="false" aria-label="Más opciones de {{ p.title }}"><i class="bi bi-three-dots-vertical"></i></button>
    <div class="lt-menu lt-menu--down" id="{{ menu_id }}" role="menu" hidden>
      <button class="lt-menu__item" role="menuitem" type="button" data-lt-toggle="plan-done"><i class="bi bi-check2-circle"></i> Registrar que lo hicimos</button>
      <button class="lt-menu__item" role="menuitem" type="button" data-lt-static-nav><i class="bi bi-calendar-plus"></i> Programar fecha</button>
      {% if module %}<a class="lt-menu__item" role="menuitem" href="#/plans-show"><i class="bi bi-eye"></i> Ver detalle</a>{% else %}<button class="lt-menu__item" role="menuitem" type="button" data-lt-static-nav><i class="bi bi-clock-history"></i> Ver historial</button>{% endif %}
      <button class="lt-menu__item" role="menuitem" type="button" data-lt-static-nav><i class="bi bi-link-45deg"></i> Añadir enlace</button>
      <button class="lt-menu__item" role="menuitem" type="button" data-lt-static-nav><i class="bi bi-person-plus"></i> Asociar a otra persona</button>
      <hr class="lt-menu__divider">
      <button class="lt-menu__item lt-menu__item--danger" role="menuitem" type="button" data-lt-static-nav><i class="bi {{ 'bi-trash' if module else 'bi-x-circle' }}"></i> {{ 'Eliminar plan' if module else 'Quitar de esta relación' }}</button>
    </div>
  </div>
</div>
{%- endmacro %}
{% macro showcase() -%}<div class="lt-page"><div class="lt-plan-list">{{ plan_row({'variant':'pending','icon':'bi-cup-straw','title':'Heladería Popsy','city':'Popayán','type':'Postres','category':'Gastronomía','status':'Pendiente','tone':'success','last':'hace 3 meses','visits':8,'people':['Camila','Familia','+1']}, 'catalog-plan-1', true) }}{{ plan_row({'variant':'scheduled','icon':'bi-music-note-beamed','title':'Concierto Morat','city':'Bogotá','type':'Concierto','category':'Música','status':'Programado','tone':'warning','date':'Dom, 15 nov. 2026','left':'Faltan 64 días','last':'nunca','visits':0}, 'catalog-plan-2') }}</div></div>{%- endmacro %}
{% macro plan_dialogs(person=None) -%}
{% call dialog('plan-new', 'Agregar plan', 'Guardar', 'bi-map', [('basic','Información básica','bi-file-earmark-text'),('people','Personas y círculos','bi-people'),('links','Enlaces','bi-link-45deg'),('summary','Resumen','bi-check2-circle')]) %}
<section class="lt-dialog__section" data-section="basic">
  <header class="lt-dialog__section-head"><h3>Información básica</h3></header>
  <div class="lt-form">
    <label class="lt-field lt-form--full"><span>Nombre <b>*</b></span><input type="text" placeholder="Ej. Heladería Popsy"></label>
    <label class="lt-field lt-field--icon"><span>Tipo <b>*</b></span><i class="bi bi-tag" aria-hidden="true"></i><select>{% for t in ['Restaurante','Viaje','Actividad','Cine','Concierto','Evento','Lugar','Postres','Museo','Naturaleza','Experiencia'] %}<option>{{ t }}</option>{% endfor %}</select></label>
    <label class="lt-field lt-field--icon"><span>Categoría</span><i class="bi bi-bookmark" aria-hidden="true"></i><select>{% for t in ['Gastronomía','Música','Entretenimiento','Aire libre','Cultura'] %}<option>{{ t }}</option>{% endfor %}</select></label>
    <label class="lt-field lt-field--icon"><span>Ciudad</span><i class="bi bi-geo-alt" aria-hidden="true"></i><input type="text" value="Popayán"></label>
    <label class="lt-field"><span>Fecha (opcional)</span><input type="date"></label>
  </div>
</section>
<section class="lt-dialog__section" data-section="people" hidden>
  <header class="lt-dialog__section-head"><h3>Personas y círculos</h3></header>
  <div class="lt-field"><span id="plan-circles-label">Círculos</span>
    <div class="lt-multiselect"><button class="lt-multiselect__trigger" type="button" data-lt-toggle="plan-circles-options" aria-haspopup="listbox" aria-expanded="false" aria-labelledby="plan-circles-label"><span>Selecciona círculos</span><i class="bi bi-chevron-down"></i></button>
      <div class="lt-multiselect__panel" id="plan-circles-options" role="listbox" aria-multiselectable="true" hidden>{% for r, on in [('Pareja',false),('Familia',false),('Amigos cercanos',false),('Amigos',false),('Trabajo',false)] %}<label class="lt-multiselect__option"><input type="checkbox"{% if on %} checked{% endif %}> {{ r }}</label>{% endfor %}</div>
    </div>
  </div>
  <div class="lt-field"><span id="plan-people-label">Con quién</span>
    <div class="lt-multiselect"><button class="lt-multiselect__trigger" type="button" data-lt-toggle="plan-people-options" aria-haspopup="listbox" aria-expanded="false" aria-labelledby="plan-people-label"><span>{{ person or 'Selecciona personas' }}</span><i class="bi bi-chevron-down"></i></button>
      <div class="lt-multiselect__panel" id="plan-people-options" role="listbox" aria-multiselectable="true" hidden>{% for r, on in [('Camila Rojas',person == 'Camila Rojas'),('María Ortiz',false),('Daniel Pérez',false),('Laura Gómez',false)] %}<label class="lt-multiselect__option"><input type="checkbox"{% if on %} checked{% endif %}> {{ r }}</label>{% endfor %}</div>
    </div>
  </div>
</section>
<section class="lt-dialog__section" data-section="links" hidden>
  <header class="lt-dialog__section-head"><h3>Enlaces</h3></header>
  <div class="lt-form"><label class="lt-field lt-field--icon lt-form--full"><span>URL</span><i class="bi bi-link-45deg" aria-hidden="true"></i><input type="url" placeholder="Instagram, TikTok, Google Maps o cualquier web"></label></div>
</section>
<section class="lt-dialog__section" data-section="summary" hidden>
  <header class="lt-dialog__section-head"><h3>Resumen</h3></header>
  <dl class="lt-dl">{% for k, val in [('Nombre','—'),('Tipo','Restaurante'),('Ciudad','Popayán'),('Fecha','Sin fecha'),('Círculos','—'),('Personas',person or '—'),('Enlaces','Ninguno')] %}<div><dt>{{ k }}</dt><dd>{{ val }}</dd></div>{% endfor %}</dl>
</section>
{% endcall %}
{% call dialog('plan-done', 'Registrar plan realizado', 'Guardar', 'bi-check2-circle') %}
<div class="lt-form">
  <label class="lt-field lt-form--full"><span>Fecha <b>*</b></span><input type="date" value="2026-09-12"></label>
  <div class="lt-field"><span id="plan-done-people-label">Con quién fuiste <b>*</b></span>
    <div class="lt-multiselect"><button class="lt-multiselect__trigger" type="button" data-lt-toggle="plan-done-people-options" aria-haspopup="listbox" aria-expanded="false" aria-labelledby="plan-done-people-label"><span>{{ person or 'Selecciona personas' }}</span><i class="bi bi-chevron-down"></i></button>
      <div class="lt-multiselect__panel" id="plan-done-people-options" role="listbox" aria-multiselectable="true" hidden>{% for r, on in [('Camila Rojas',person == 'Camila Rojas'),('María Ortiz',false),('Julián Ortiz',false),('Daniel Pérez',false),('Laura Gómez',false)] %}<label class="lt-multiselect__option"><input type="checkbox"{% if on %} checked{% endif %}> {{ r }}</label>{% endfor %}</div>
    </div>
  </div>
  <label class="lt-field lt-form--full"><span>Comentario</span><textarea placeholder="Opcional"></textarea></label>
</div>
{% endcall %}
{%- endmacro %}
