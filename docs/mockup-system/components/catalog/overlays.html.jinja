{% macro sheet(id, open=false) -%}<div data-ui-component="life-tracker/overlays/sheet" data-ui-variant="bottom" data-ui-state="{{ 'open' if open else 'closed' }}"><button class="lt-button lt-button--tonal" type="button" data-catalog-open="{{ id }}">Registrar</button><section id="{{ id }}" class="lt-panel"{% if not open %} hidden{% endif %}><div class="lt-panel__body"><strong>Registrar actividad</strong><p>Hoja temporal con contenido y acción de cierre visibles.</p><button class="lt-button" type="button" data-catalog-close="{{ id }}">Cerrar</button></div></section></div>{%- endmacro %}
{% macro showcase() -%}<div class="lt-page">{{ sheet('lt-catalog-sheet') }}{{ sheet('lt-catalog-sheet-open', true) }}</div>{%- endmacro %}
