{% from '@project/components/life-shell.html.jinja' import shell, tabs as module_tabs, dialog, fab %}
{% from '@project/components/catalog/plan-row.html.jinja' import plan_row, plan_dialogs %}
{% call shell('plans', 'Planes', 'bi-map') %}
{{ module_tabs([('Todos','/plans-index','bi-grid'),('Programados',None,'bi-calendar-event',true),('Historial',None,'bi-clock-history',true)], '/plans-index') }}
