{% from '@project/components/life-shell.html.jinja' import shell, header, metric %}
{% from '@project/components/catalog/plan-row.html.jinja' import plan_dialogs %}
{% call shell('plans', 'Heladería Popsy', 'bi-cup-straw') %}
{{ header('Heladería Popsy', '', 'bi-cup-straw', '/plans-index') }}
<div class="lt-plan-gallery" role="group" aria-label="Imágenes de Heladería Popsy">
  {% for src, alt in [('data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%270 0 120 90%27%3E%3Crect width=%27120%27 height=%2790%27 fill=%27%23FCE4EC%27/%3E%3Ccircle cx=%2745%27 cy=%2734%27 r=%2716%27 fill=%27%23F48FB1%27/%3E%3Ccircle cx=%2772%27 cy=%2736%27 r=%2714%27 fill=%27%23FFF3E0%27/%3E%3Cpath d=%27M32 44h28l-14 38z%27 fill=%27%23D7A86E%27/%3E%3Cpath d=%27M60 46h24l-12 34z%27 fill=%27%23C48A55%27/%3E%3C/svg%3E','Imagen principal de Heladería Popsy'),('data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%270 0 120 90%27%3E%3Crect width=%27120%27 height=%2790%27 fill=%27%23FFF8E1%27/%3E%3Crect x=%2720%27 y=%2750%27 width=%2780%27 height=%278%27 fill=%27%238D6E63%27/%3E%3Ccircle cx=%2760%27 cy=%2738%27 r=%2714%27 fill=%27%23FFFFFF%27/%3E%3Ccircle cx=%2760%27 cy=%2738%27 r=%278%27 fill=%27%23A5D6A7%27/%3E%3Crect x=%2714%27 y=%2712%27 width=%2722%27 height=%2730%27 rx=%273%27 fill=%27%23FFE0B2%27/%3E%3C/svg%3E','Imagen 2 de Heladería Popsy'),('data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%270 0 120 90%27%3E%3Crect width=%27120%27 height=%2790%27 fill=%27%23E3F2FD%27/%3E%3Cpath d=%27M0 60 35 25l25 25 20-18 40 36v22H0z%27 fill=%27%2381C784%27/%3E%3Cpath d=%27M0 72h120v18H0z%27 fill=%27%234FC3F7%27/%3E%3Ccircle cx=%2795%27 cy=%2720%27 r=%279%27 fill=%27%23FFF59D%27/%3E%3C/svg%3E','Imagen 3 de Heladería Popsy')] %}
  <button class="lt-plan-gallery__item{% if loop.first %} is-main{% endif %}" type="button" data-lt-static-nav><img src="{{ src }}" alt="{{ alt }}"></button>
  {% endfor %}
</div>
<section class="lt-metrics">{{ metric('Visitas','8') }}{{ metric('Última vez','Hace 3 meses','warning') }}{{ metric('Personas','3','success') }}</section>
<section class="lt-grid-main">
  <div class="lt-stack">
    <article class="lt-panel lt-panel--accent"><div class="lt-panel__head"><i class="bi bi-clock-history"></i><h3>Historial</h3><button class="lt-button" type="button" data-lt-toggle="plan-done"><i class="bi bi-check2-circle"></i> Registrar visita</button></div><div class="lt-panel__body">
      <div class="lt-timeline">
        {% for date, who, note in [('14 jun. 2026','Camila Rojas','Probamos el de maracuyá; el mejor hasta ahora.'),('2 may. 2026','María Ortiz, Julián Ortiz',''),('21 mar. 2026','Camila Rojas','Después del cine.'),('8 feb. 2026','Familia','Cumpleaños de mamá.'),('30 dic. 2025','Camila Rojas','')] %}
        <div class="lt-timeline__item"><span class="lt-timeline__dot"></span><div><strong>{{ date }}</strong><span><i class="bi bi-people" aria-hidden="true"></i> {{ who }}</span>{% if note %}<p>{{ note }}</p>{% endif %}</div></div>
        {% endfor %}
      </div>
    </div></article>
  </div>
  <aside class="lt-stack">
    <article class="lt-panel"><div class="lt-panel__head"><i class="bi bi-info-circle"></i><h3>Datos</h3><button class="lt-button lt-button--text" type="button" data-lt-static-nav><i class="bi bi-pencil"></i> Editar</button></div><div class="lt-panel__body">
      <dl class="lt-dl"><div><dt>Estado</dt><dd><span class="lt-chip lt-chip--success">Pendiente</span></dd></div><div><dt>Tipo</dt><dd>Postres</dd></div><div><dt>Categoría</dt><dd>Gastronomía</dd></div><div><dt>Ciudad</dt><dd>Popayán</dd></div><div><dt>Dirección</dt><dd>Cra. 6 # 3-45, Centro</dd></div></dl>
    </div></article>
    <article class="lt-panel"><div class="lt-panel__head"><i class="bi bi-people"></i><h3>Personas asociadas</h3></div><div class="lt-panel__body"><div class="lt-list">
      {% for initials, name, meta in [('CR','Camila Rojas','5 visitas · última hace 3 meses'),('MO','María Ortiz','2 visitas · última hace 4 meses'),('FA','Familia','1 visita · última hace 7 meses')] %}<button class="lt-list-item" type="button" data-lt-static-nav><span class="lt-avatar">{{ initials }}</span><div class="lt-list-item__body"><strong>{{ name }}</strong><span>{{ meta }}</span></div><i class="bi bi-chevron-right lt-list-item__trail" aria-hidden="true"></i></button>{% endfor %}
    </div><button class="lt-button lt-button--text lt-link-share" type="button" data-lt-static-nav><i class="bi bi-person-plus"></i> Asociar persona</button></div></article>
    <article class="lt-panel"><div class="lt-panel__head"><i class="bi bi-link-45deg"></i><h3>Enlaces</h3></div><div class="lt-panel__body"><div class="lt-list">
      {% for icon, title, meta in [('bi-instagram','@heladeriapopsy','Instagram'),('bi-geo-alt-fill','Popsy Centro','Google Maps')] %}<button class="lt-list-item" type="button" data-lt-static-nav><span class="lt-list-item__icon"><i class="bi {{ icon }}"></i></span><div class="lt-list-item__body"><strong>{{ title }}</strong><span>{{ meta }}</span></div><i class="bi bi-box-arrow-up-right lt-list-item__trail" aria-hidden="true"></i></button>{% endfor %}
    </div><button class="lt-button lt-button--text lt-link-share" type="button" data-lt-static-nav><i class="bi bi-plus-lg"></i> Compartir enlace</button></div></article>
  </aside>
</section>
{{ plan_dialogs() }}
{% endcall %}
