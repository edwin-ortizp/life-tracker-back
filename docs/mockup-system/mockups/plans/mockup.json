{
  "schemaVersion": 1,
  "id": "plans",
  "version": "1.0.0",
  "title": "Planes",
  "pages": [
    {
      "id": "main",
      "template": "pages/main.html.jinja",
      "screens": [
        "plans-index",
        "plans-show",
        "plans-settings",
        "plans-scheduled",
        "plans-history",
        "plans-contact",
        "plans-categories"
      ],
      "output": "plans.html"
    }
  ],
  "screens": {
    "plans-index": {
      "template": "screens/plans-index.html.jinja",
      "title": "Planes",
      "bodyClass": ""
    },
    "plans-show": {
      "template": "screens/plans-show.html.jinja",
      "title": "Detalle de plan",
      "bodyClass": ""
    },
    "plans-settings": {
      "template": "screens/plans-settings.html.jinja",
      "title": "Ajustes de Planes",
      "bodyClass": ""
    },
    "plans-scheduled": {
      "template": "screens/plans-scheduled.html.jinja",
      "title": "Programados",
      "bodyClass": ""
    },
    "plans-history": {
      "template": "screens/plans-history.html.jinja",
      "title": "Historial",
      "bodyClass": ""
    },
    "plans-contact": {
      "template": "screens/plans-contact.html.jinja",
      "title": "Contacto",
      "bodyClass": ""
    },
    "plans-categories": {
      "template": "screens/plans-categories.html.jinja",
      "title": "Categorías de Planes",
      "bodyClass": ""
    }
  },
  "routes": [
    {
      "path": "/plans-index",
      "screen": "plans-index"
    },
    {
      "path": "/plans-show",
      "screen": "plans-show"
    },
    {
      "path": "/plans-settings",
      "screen": "plans-settings"
    },
    {
      "path": "/plans-scheduled",
      "screen": "plans-scheduled"
    },
    {
      "path": "/plans-history",
      "screen": "plans-history"
    },
    {
      "path": "/relationships-show",
      "screen": "plans-contact"
    },
    {
      "path": "/plans-categories",
      "screen": "plans-categories"
    }
  ],
  "datasets": {
    "include": [
      "empty",
      "alternate"
    ],
    "default": "empty",
    "switcher": true,
    "changePolicy": "reset"
  },
  "roles": [
    "reviewer"
  ],
  "defaultRole": "reviewer",
  "entryRoute": "/plans-index",
  "entryScript": "scripts/entry.js",
  "styles": [
    "@project/project-assets/mockups.css",
    "styles/plans.css"
  ],
  "runtime": {
    "persistence": "none",
    "resetEnabled": true
  },
  "build": {
    "selfContained": true,
    "offline": true,
    "externalResources": "forbid",
    "externalNavigation": "forbid",
    "maxOutputBytes": 10000000
  }
}
