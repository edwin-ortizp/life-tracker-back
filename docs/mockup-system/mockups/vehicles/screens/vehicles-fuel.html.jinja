{% from '@project/components/vehicle-dialogs.html.jinja' import fuel_dialog, dialog %}
{% from '@project/components/life-shell.html.jinja' import fab %}
{% from '@project/components/life-shell.html.jinja' import shell, vehicle_tabs, tabs as module_tabs, header, metric, manage_card %}
{% call shell('vehicles', 'Chevrolet Cruze', 'bi-car-front', status='Activo') %}
{{ vehicle_tabs('/vehicles-fuel') }}
<section class="lt-metrics">{{ metric('Rendimiento último tanque','14,8 km/gal','success') }}{{ metric('Gasto del mes','$ 412.000') }}{{ metric('Precio promedio','$ 15.980 / gal','warning') }}</section>
<section>
  {% call(zone) manage_card('fuel', 'Historial de repostajes', 'bi-fuel-pump', count='(4 / 32)', total=32, search='Buscar estación o fecha', menu=[('Exportar CSV', 'bi-filetype-csv')], footer={'from':1,'to':4,'total':32,'noun':'repostajes','page':1,'pages':2,'per_page':25}) %}{% if zone == 'filters' %}
      <div class="lt-popover" id="fuel-filters" role="dialog" aria-labelledby="fuel-filters-title" hidden><span class="lt-popover__handle" aria-hidden="true"></span>
        <div class="lt-popover__head"><h4 id="fuel-filters-title">Filtros</h4><button class="lt-icon-button" type="button" data-lt-toggle="fuel-filters" aria-label="Cerrar filtros"><i class="bi bi-x-lg"></i></button></div>
        <label class="lt-field"><span>Periodo</span><select><option>Último mes</option><option selected>Últimos 3 meses</option><option>Último año</option><option>Todo el historial</option></select></label>
        <label class="lt-field"><span>Estación</span><select><option>Todas</option><option>Terpel Av. 68</option><option>Esso Calle 80</option><option>Primax Autopista</option></select></label>
        <div class="lt-field"><span>Tanque</span><div class="lt-chip-row"><button class="lt-chip lt-chip--filter is-selected" type="button" data-lt-static-nav aria-pressed="true">Todos</button><button class="lt-chip lt-chip--filter" type="button" data-lt-static-nav>Lleno</button><button class="lt-chip lt-chip--filter" type="button" data-lt-static-nav>Parcial</button></div></div>
        <div class="lt-popover__actions"><button class="lt-button lt-button--outlined" type="button" data-lt-static-nav><i class="bi bi-eraser" aria-hidden="true"></i>Limpiar</button><button class="lt-button" type="button" data-lt-toggle="fuel-filters"><i class="bi bi-funnel-fill" aria-hidden="true"></i>Filtrar</button></div>
      </div>
    {% else %}
<div class="lt-list">
    {% for date, place, liters, cost, km, perf, full in [('6 sep.','Terpel Av. 68','10,1 gal','$ 161.400','142.410 km','14,8 km/gal',true),('27 ago.','Esso Calle 80','9,2 gal','$ 147.900','141.845 km','14,1 km/gal',true),('19 ago.','Terpel Av. 68','4,9 gal','$ 78.200','141.350 km','—',false),('9 ago.','Primax Autopista','10,6 gal','$ 169.400','140.990 km','13,9 km/gal',true)] %}
    <div class="lt-list-item"><span class="lt-list-item__icon"><i class="bi bi-fuel-pump"></i></span><div class="lt-list-item__body"><strong>{{ date }} · {{ liters }} · {{ cost }}</strong><span>{{ place }} · {{ km }}{% if not full %} · tanque parcial{% endif %}</span></div><div class="lt-list-item__meta"><span class="lt-chip{% if full %} lt-chip--success{% else %} lt-chip--neutral{% endif %}">{{ perf }}</span></div></div>
    {% endfor %}
  </div>{% endif %}{% endcall %}
</section>
{{ fab('Registrar repostaje', 'bi-plus-lg', 'vehicle-fuel-new') }}
{{ fuel_dialog() }}
{% endcall %}
