{% from '@project/components/vehicle-dialogs.html.jinja' import fuel_dialog, dialog %}
{% from '@project/components/life-shell.html.jinja' import fab %}
{% from '@project/components/life-shell.html.jinja' import shell, vehicle_tabs, tabs as module_tabs, header, metric %}
{% call shell('vehicles', 'Chevrolet Cruze', 'bi-car-front', status='Activo') %}
{{ vehicle_tabs('/vehicles-fuel') }}
<section class="lt-metrics">{{ metric('Rendimiento último tanque','14,8 km/gal','success') }}{{ metric('Gasto del mes','$ 412.000') }}{{ metric('Precio promedio','$ 15.980 / gal','warning') }}</section>
<section>
  <article class="lt-panel lt-panel--accent"><div class="lt-panel__head"><i class="bi bi-clock-history"></i><h3>Historial</h3><small>Últimos repostajes</small></div><div class="lt-panel__body"><div class="lt-list">
    {% for date, place, liters, cost, km, perf, full in [('6 sep.','Terpel Av. 68','10,1 gal','$ 161.400','142.410 km','14,8 km/gal',true),('27 ago.','Esso Calle 80','9,2 gal','$ 147.900','141.845 km','14,1 km/gal',true),('19 ago.','Terpel Av. 68','4,9 gal','$ 78.200','141.350 km','—',false),('9 ago.','Primax Autopista','10,6 gal','$ 169.400','140.990 km','13,9 km/gal',true)] %}
    <div class="lt-list-item"><span class="lt-list-item__icon"><i class="bi bi-fuel-pump"></i></span><div class="lt-list-item__body"><strong>{{ date }} · {{ liters }} · {{ cost }}</strong><span>{{ place }} · {{ km }}{% if not full %} · tanque parcial{% endif %}</span></div><div class="lt-list-item__meta"><span class="lt-chip{% if full %} lt-chip--success{% else %} lt-chip--neutral{% endif %}">{{ perf }}</span></div></div>
    {% endfor %}
  </div></div></article>
</section>
{{ fab('Registrar repostaje', 'bi-plus-lg', 'vehicle-fuel-new') }}
{{ fuel_dialog() }}
{% endcall %}
