{% from '@project/components/life-shell.html.jinja' import shell, tabs as module_tabs, metric, dialog, fab, manage_card %}
{% call shell('negative-habits', 'Hábitos a evitar', 'bi-shield-check') %}
{{ module_tabs([('Semana','/negative-weekly','bi-calendar-week'),('Tendencia','/negative-trend','bi-graph-down')], '/negative-weekly') }}
<section class="lt-toolbar"><button class="lt-icon-button" type="button" data-lt-static-nav aria-label="Semana anterior"><i class="bi bi-chevron-left"></i></button><p class="lt-toolbar__label">Esta semana · 8 – 14 sep.</p><button class="lt-icon-button" type="button" data-lt-static-nav aria-label="Semana siguiente"><i class="bi bi-chevron-right"></i></button></section>
<section class="lt-metrics">{{ metric('Incidencias esta semana','6','warning') }}{{ metric('Días limpios','8 de 12','success') }}{{ metric('Frente a la semana pasada','−40 %','success') }}</section>
<section class="lt-stack">
  {% call(zone) manage_card('negative-week', 'Registro semanal', 'bi-calendar-week', search='Buscar hábito', menu=[('Exportar CSV', 'bi-filetype-csv')], footer={'from':1,'to':4,'total':4,'noun':'hábitos','page':1,'pages':1,'per_page':25}) %}{% if zone == 'filters' %}
      <div class="lt-popover" id="negative-week-filters" role="dialog" aria-labelledby="negative-week-filters-title" hidden>
        <div class="lt-popover__head"><h4 id="negative-week-filters-title">Filtros</h4><button class="lt-icon-button" type="button" data-lt-toggle="negative-week-filters" aria-label="Cerrar filtros"><i class="bi bi-x-lg"></i></button></div>
        <div class="lt-field"><span>Hábito</span><div class="lt-chip-row"><button class="lt-chip lt-chip--filter is-selected" type="button" data-lt-static-nav aria-pressed="true">Todos</button><button class="lt-chip lt-chip--filter" type="button" data-lt-static-nav>Redes sociales de noche</button><button class="lt-chip lt-chip--filter" type="button" data-lt-static-nav>Gaseosa</button><button class="lt-chip lt-chip--filter" type="button" data-lt-static-nav>Compras impulsivas</button><button class="lt-chip lt-chip--filter" type="button" data-lt-static-nav>Picar entre comidas</button></div></div>
        <label class="lt-field"><span>Estado</span><select><option>Todos</option><option>Dentro del límite</option><option>Fuera del límite</option></select></label>
        <div class="lt-popover__actions"><button class="lt-button lt-button--text" type="button" data-lt-static-nav>Limpiar</button><button class="lt-button" type="button" data-lt-toggle="negative-week-filters">Aplicar</button></div>
      </div>
    {% else %}
    <p class="lt-section-label">Toca un día para registrar</p>

    <div class="lt-habit-week" role="table" aria-label="Incidencias por hábito y día">
      <div class="lt-habit-week__row lt-habit-week__row--head" role="row"><span role="columnheader">Hábito</span>{% for d, today in [('L 8',false),('M 9',false),('X 10',true),('J 11',false),('V 12',false),('S 13',false),('D 14',false)] %}<span role="columnheader"{% if today %} class="is-today"{% endif %}>{{ d }}</span>{% endfor %}<span role="columnheader">Total</span></div>
      {% for icon, name, limit, days, total, delta in [
        ('bi-phone','Redes sociales de noche','Límite: 0 veces después de las 22:00',[0,2,1,None,None,None,None],3,'Semana pasada: 7'),
        ('bi-cup-straw','Gaseosa','Límite: 1 por semana',[0,0,1,None,None,None,None],1,'Dentro del límite'),
        ('bi-cash-coin','Compras impulsivas','Límite: 0',[0,0,0,None,None,None,None],0,'3 días limpio'),
        ('bi-cookie','Picar entre comidas','Límite: 3 por semana',[1,0,1,None,None,None,None],2,'Semana pasada: 4')
      ] %}
      <div class="lt-habit-week__row" role="row">
        <div class="lt-list-item" role="rowheader"><span class="lt-list-item__icon"><i class="bi {{ icon }}"></i></span><div class="lt-list-item__body"><strong>{{ name }}</strong><span>{{ limit }}</span></div></div>
        {% for v in days %}{% set today = loop.index == 3 %}
        {% if v is none %}<span class="lt-habit-cell is-future" role="cell" aria-label="Sin registrar"></span>
        {% elif v == 0 %}<button class="lt-habit-cell is-clean{% if today %} is-today{% endif %}" type="button" role="cell" data-lt-static-nav aria-label="{{ name }}: día limpio"><i class="bi bi-check-lg"></i></button>
        {% else %}<button class="lt-habit-cell {% if v > 1 %}is-heavy{% else %}is-slip{% endif %}{% if today %} is-today{% endif %}" type="button" role="cell" data-lt-static-nav aria-label="{{ name }}: {{ v }} incidencias">{{ v }}</button>{% endif %}
        {% endfor %}
        <div class="lt-habit-week__total" role="cell">{{ total }}<small>{{ delta }}</small></div>
      </div>
      {% endfor %}
    </div>
    <div class="lt-legend"><span><i class="bi bi-check-lg"></i> Día limpio</span><span>1 Una incidencia</span><span>2+ Varias</span></div>
  {% endif %}{% endcall %}
  <div>
    <article class="lt-panel"><div class="lt-panel__head"><i class="bi bi-lightbulb"></i><h3>Plan de reemplazo</h3></div><div class="lt-panel__body"><div class="lt-list">
      <div class="lt-list-item"><span class="lt-list-item__icon"><i class="bi bi-book"></i></span><div class="lt-list-item__body"><strong>Leer 10 páginas en vez de redes</strong><span>Funcionó 4 de 6 noches</span></div></div>
      <div class="lt-list-item"><span class="lt-list-item__icon"><i class="bi bi-cup-hot"></i></span><div class="lt-list-item__body"><strong>Agua con limón en vez de gaseosa</strong><span>Funcionó 5 de 6 veces</span></div></div>
    </div></div></article>
  </div>
</section>
{{ fab('Registrar incidencia', 'bi-pencil-square', 'negative-log-new') }}
{% call dialog('negative-log-new', 'Registrar incidencia', icon='bi-pencil-square', sections=[('basic','Información básica','bi-shield-exclamation'),('details','Detalles adicionales','bi-card-text')]) %}
<section class="lt-dialog__section" data-section="basic">
  <header class="lt-dialog__section-head"><h3>Información básica</h3></header>
  <div class="lt-form">
        <label class="lt-field lt-form--full"><span>Hábito</span><select><option>Redes sociales de noche</option><option>Gaseosa</option><option>Compras impulsivas</option><option>Picar entre comidas</option></select></label>
        <label class="lt-field"><span>Fecha</span><input type="date" value="2026-09-10"></label>
        <label class="lt-field"><span>Hora</span><input type="time" value="22:40"></label>
  </div>
</section>
<section class="lt-dialog__section" data-section="details" hidden>
  <header class="lt-dialog__section-head"><h3>Detalles adicionales</h3></header>
  <div class="lt-form">
        <label class="lt-field lt-form--full"><span>¿Qué lo disparó?</span><select><option>Cansancio</option><option>Aburrimiento</option><option>Estrés</option><option>Situación social</option></select></label>
        <label class="lt-field lt-form--full"><span>Nota</span><textarea placeholder="Qué pasó y qué podrías hacer distinto la próxima vez">Revisé Instagram en la cama después de una reunión tensa.</textarea></label>
  </div>
</section>
{% endcall %}
{% endcall %}
