{
  "schemaVersion": 1,
  "id": "hydration",
  "version": "1.0.0",
  "title": "Hidratación",
  "pages": [
    {
      "id": "main",
      "template": "pages/main.html.jinja",
      "screens": [
        "water-daily",
        "water-weekly",
        "water-settings",
        "drinks-categories"
      ],
      "output": "hydration.html"
    }
  ],
  "screens": {
    "water-daily": {
      "template": "screens/water-daily.html.jinja",
      "title": "Registro diario",
      "bodyClass": ""
    },
    "water-weekly": {
      "template": "screens/water-weekly.html.jinja",
      "title": "Resumen semanal",
      "bodyClass": ""
    },
    "water-settings": {
      "template": "screens/water-settings.html.jinja",
      "title": "Ajustes",
      "bodyClass": ""
    },
    "drinks-categories": {
      "template": "screens/drinks-categories.html.jinja",
      "title": "Categorías de Bebidas",
      "bodyClass": ""
    }
  },
  "routes": [
    {
      "path": "/water-daily",
      "screen": "water-daily"
    },
    {
      "path": "/water-weekly",
      "screen": "water-weekly"
    },
    {
      "path": "/water-settings",
      "screen": "water-settings"
    },
    {
      "path": "/drinks-categories",
      "screen": "drinks-categories"
    }
  ],
  "datasets": {
    "include": [
      "empty",
      "alternate"
    ],
    "default": "empty",
    "switcher": true,
    "changePolicy": "reset"
  },
  "roles": [
    "reviewer"
  ],
  "defaultRole": "reviewer",
  "entryRoute": "/water-daily",
  "entryScript": "scripts/entry.js",
  "styles": [
    "@project/project-assets/mockups.css"
  ],
  "runtime": {
    "persistence": "none",
    "resetEnabled": true
  },
  "build": {
    "selfContained": true,
    "offline": true,
    "externalResources": "forbid",
    "externalNavigation": "forbid",
    "maxOutputBytes": 10000000
  }
}
