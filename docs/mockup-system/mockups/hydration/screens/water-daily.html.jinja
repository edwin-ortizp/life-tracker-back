{% from '@project/components/life-shell.html.jinja' import shell, tabs as module_tabs, header, goal_calendar, manage_card, fab, row_split, applied_filters, date_filters %}
{% call shell('hydration', 'Registro diario', 'bi-droplet') %}
{{ header('Registro diario', 'Consumo, objetivo y momentos del día.', 'bi-droplet') }}
{{ module_tabs([('Registro diario','/water-daily','bi-droplet-half'),('Resumen semanal','/water-weekly','bi-bar-chart-line'),('Ajustes','/water-settings','bi-sliders')], '/water-daily') }}
<section class="lt-grid-main">{% call(zone) manage_card('water-log', 'Registro de hoy', 'bi-clock-history', count='(3 / 142)', total=142, search='Buscar registros', filters=1, menu=[('Exportar CSV', 'bi-filetype-csv')], footer={'from':1,'to':3,'total':3,'noun':'registros','page':1,'pages':1,'per_page':25}, footer_all={'to':25,'total':142,'pages':6}) %}{% if zone == 'filters' %}
  {% call date_filters('water-log') %}<label class="lt-field"><span>Bebida</span><select><option>Todas</option><option>Agua</option><option>Café</option><option>Té verde</option><option>Jugo de naranja</option></select></label>{% endcall %}
{% else %}
  {{ applied_filters([('bi-calendar-event','Fecha: Hoy')]) }}
  <table class="lt-mtable">
    <thead><tr><th scope="col">Fecha</th><th scope="col">Hora</th><th scope="col">Bebida</th><th scope="col">Cantidad</th><th scope="col">Hidratación efectiva</th><th scope="col" class="lt-mtable__actions">Acciones</th></tr></thead>
    <tbody>
    {% for date, time, icon, drink, ml, eff, old in [('Hoy','15:00','💧','Agua','650 ml','650 ml',false),('Hoy','11:30','☕','Café','250 ml','200 ml',false),('Hoy','08:00','💧','Agua','350 ml','350 ml',false),('12 sep.','21:10','🍵','Té verde','300 ml','270 ml',true),('12 sep.','17:45','💧','Agua','500 ml','500 ml',true),('12 sep.','09:05','☕','Café','250 ml','200 ml',true),('11 sep.','19:30','🧃','Jugo de naranja','400 ml','340 ml',true)] %}
      <tr{% if old %} data-lt-outside-filter{% endif %}>
        <td class="lt-mtable__date" data-label="Fecha">{{ date }}</td>
        <td class="lt-mtable__time" data-label="Hora">{{ time }}</td>
        <td class="lt-mtable__type" data-label="Bebida"><span aria-hidden="true">{{ icon }}</span> {{ drink }}</td>
        <td data-label="Cantidad"><strong>{{ ml }}</strong></td>
        <td data-label="Hidratación efectiva">{{ eff }}</td>
        <td class="lt-mtable__actions">{{ row_split('water-log-menu-' ~ loop.index, 'Editar', [('Eliminar','bi-trash',true)], 'el registro de ' ~ date ~ ' a las ' ~ time) }}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
{% endif %}{% endcall %}
{% macro liters(ml) %}{{ '%.1f'|format(ml / 1000)|replace('.', ',') }} L{% endmacro %}
{% set consumed_ml, goal_ml = 1500, 2200 %}
{% set today_pct = (consumed_ml * 100 / goal_ml)|round|int %}
<aside class="lt-stack">
  <article class="lt-panel lt-panel--accent">
    <div class="lt-panel__head"><i class="bi bi-droplet"></i><h3>Objetivo de hoy</h3></div>
    <div class="lt-panel__body">
      <p class="lt-goal-today"><strong>{{ liters(consumed_ml) }} <span>/ {{ liters(goal_ml) }}</span></strong><b>{{ today_pct }} %</b></p>
      <div class="lt-progress" role="img" aria-label="{{ today_pct }} % de la meta diaria"><span style="width:{{ [today_pct, 100]|min }}%"></span></div>
      <p class="lt-page-head__subtitle">{% if consumed_ml < goal_ml %}Faltan {{ goal_ml - consumed_ml }} ml para alcanzar tu meta diaria.{% else %}Superaste tu meta por {{ consumed_ml - goal_ml }} ml.{% endif %}</p>
    </div>
  </article>
  <article class="lt-panel">
    <div class="lt-panel__head"><i class="bi bi-calendar3"></i><h3>Calendario del mes</h3>
      <div class="lt-month-nav"><button class="lt-icon-button" type="button" data-lt-static-nav aria-label="Mes anterior"><i class="bi bi-chevron-left"></i></button><span>Septiembre 2026</span><button class="lt-icon-button" type="button" data-lt-static-nav aria-label="Mes siguiente"><i class="bi bi-chevron-right"></i></button></div>
    </div>
    <div class="lt-panel__body">
      {# (día, consumido en ml, meta vigente ese día). La meta subió de 2,0 L a 2,2 L el 10 sep. #}
      {% set days = [(1800,2000),(2100,2000),(1500,2000),(2000,2000),(1200,2000),(None,2000),(1600,2000),(2050,2000),(2000,2000),(2300,2200),(2200,2200),(2400,2200),(2250,2200),(1500,2200)] %}
      {{ goal_calendar('Cumplimiento de la meta de hidratación en septiembre de 2026', 1, 30, days, 14, 'L', 'Racha actual: 6 días cumpliendo la meta al 100%.') }}
    </div>
  </article>
</aside></section>
{{ fab('Registrar agua', 'bi-droplet') }}
{% endcall %}