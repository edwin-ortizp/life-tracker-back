{% from '@project/components/life-shell.html.jinja' import shell, tabs as module_tabs, header, metric, manage_card, fab %}
{% call shell('hydration', 'Registro diario', 'bi-droplet') %}
{{ header('Registro diario', 'Consumo, objetivo y momentos del día.', 'bi-droplet') }}
{{ module_tabs([('Registro diario','/water-daily','bi-droplet-half'),('Resumen semanal','/water-weekly','bi-bar-chart-line')], '/water-daily') }}
<section class="lt-metrics">{{ metric('Consumido','1.5 L','success') }}{{ metric('Objetivo','2.2 L') }}{{ metric('Racha','6 días') }}</section>
<section class="lt-grid-main">{% call(zone) manage_card('water-log', 'Registro de hoy', 'bi-clock-history', count='(3)', search='Buscar registros', menu=[('Exportar CSV', 'bi-filetype-csv')], footer={'from':1,'to':3,'total':3,'noun':'registros','page':1,'pages':1,'per_page':25}) %}{% if zone == 'filters' %}
      <div class="lt-popover" id="water-log-filters" role="dialog" aria-labelledby="water-log-filters-title" hidden><span class="lt-popover__handle" aria-hidden="true"></span>
        <div class="lt-popover__head"><h4 id="water-log-filters-title">Filtros</h4><button class="lt-icon-button" type="button" data-lt-toggle="water-log-filters" aria-label="Cerrar filtros"><i class="bi bi-x-lg"></i></button></div>
        <label class="lt-field"><span>Día</span><select><option selected>Hoy</option><option>Ayer</option><option>Últimos 7 días</option></select></label>
        <div class="lt-field"><span>Recipiente</span><div class="lt-chip-row"><button class="lt-chip lt-chip--filter is-selected" type="button" data-lt-static-nav aria-pressed="true">Todos</button><button class="lt-chip lt-chip--filter" type="button" data-lt-static-nav>Vaso</button><button class="lt-chip lt-chip--filter" type="button" data-lt-static-nav>Botella</button><button class="lt-chip lt-chip--filter" type="button" data-lt-static-nav>Termo</button></div></div>
        <div class="lt-popover__actions"><button class="lt-button lt-button--outlined" type="button" data-lt-static-nav><i class="bi bi-eraser" aria-hidden="true"></i>Limpiar</button><button class="lt-button" type="button" data-lt-toggle="water-log-filters"><i class="bi bi-funnel-fill" aria-hidden="true"></i>Filtrar</button></div>
      </div>
    {% else %}
<div class="lt-list">{% for time, amount in [('08:00','350 ml'),('11:30','500 ml'),('15:00','650 ml')] %}<div class="lt-list-item"><i class="bi bi-droplet-fill" style="color:var(--lt-accent)"></i><div class="lt-list-item__body"><strong>{{ amount }}</strong><span>{{ time }}</span></div></div>{% endfor %}</div>{% endif %}{% endcall %}<article class="lt-panel lt-panel--accent"><div class="lt-panel__head"><i class="bi bi-droplet"></i><h3>Objetivo de hoy</h3><small>68 %</small></div><div class="lt-panel__body"><div class="lt-progress"><span style="width:68%"></span></div><p class="lt-page-head__subtitle">Faltan 700 ml para alcanzar tu meta diaria.</p></div></article></section>
{{ fab('Registrar agua', 'bi-droplet') }}
{% endcall %}