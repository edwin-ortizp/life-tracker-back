{% from '@project/components/life-shell.html.jinja' import shell, tabs as module_tabs, header, metric, dialog, fab, manage_card %}
{% call shell('relationships', 'Relaciones', 'bi-people') %}
{{ header('Relaciones', 'Personas, círculos y momentos que quieres cuidar.', 'bi-people') }}
{{ module_tabs([('Relaciones','/relationships-index','bi-people'),('Acontecimientos','/relationships-events','bi-calendar-event'),('Cumpleaños','/relationships-birthdays','bi-cake2')], '/relationships-index') }}
<section class="lt-metrics">{{ metric('Contactos activos','46') }}{{ metric('Seguimiento vencido','4','warning') }}{{ metric('Contactados este mes','17','success') }}</section>
<section class="lt-grid-main">
  {% call(zone) manage_card('people', 'Personas', 'bi-people', count='(5 / 46)', total=46, search='Buscar por nombre, apodo, teléfono o correo', menu=[('Exportar CSV', 'bi-filetype-csv')], footer={'from':1,'to':5,'total':46,'noun':'personas','page':1,'pages':2,'per_page':25}, sort=[('name','Nombre (A–Z)','bi-sort-alpha-down'),('last','Último contacto','bi-clock-history'),('next','Próximo contacto','bi-calendar-event')]) %}{% if zone == 'filters' %}
      <div class="lt-popover" id="people-filters" role="dialog" aria-labelledby="people-filters-title" hidden><span class="lt-popover__handle" aria-hidden="true"></span>
        <div class="lt-popover__head"><h4 id="people-filters-title">Filtros</h4><button class="lt-icon-button" type="button" data-lt-toggle="people-filters" aria-label="Cerrar filtros"><i class="bi bi-x-lg"></i></button></div>
        <div class="lt-field"><span>Círculo</span><div class="lt-chip-row"><button class="lt-chip lt-chip--filter is-selected" type="button" data-lt-static-nav aria-pressed="true">Todos</button><button class="lt-chip lt-chip--filter" type="button" data-lt-static-nav>Familia</button><button class="lt-chip lt-chip--filter" type="button" data-lt-static-nav>Amigos cercanos</button><button class="lt-chip lt-chip--filter" type="button" data-lt-static-nav>Trabajo</button><button class="lt-chip lt-chip--filter" type="button" data-lt-static-nav>Archivados</button></div></div>
        <div class="lt-popover__actions"><button class="lt-button lt-button--outlined" type="button" data-lt-static-nav><i class="bi bi-eraser" aria-hidden="true"></i>Limpiar</button><button class="lt-button" type="button" data-lt-toggle="people-filters"><i class="bi bi-funnel-fill" aria-hidden="true"></i>Filtrar</button></div>
      </div>
    {% else %}
    {% for circle, people in [
      ('Familia', [('MO','María Ortiz','Mamá · cada semana','Hace 9 días','warning','Vencido'),('JO','Julián Ortiz','Hermano · cada 2 semanas','Hace 4 días','success','Al día')]),
      ('Amigos cercanos', [('CR','Camila Rojas','Universidad · cada mes','Hace 45 días','warning','Vencido'),('DP','Daniel Pérez','Fútbol · cada 2 semanas','Hace 6 días','success','Al día')]),
      ('Trabajo', [('LG','Laura Gómez','Mentora · cada 2 meses','Hace 30 días','neutral','En 30 días')])
    ] %}
    <p class="lt-section-label">{{ circle }}</p>
    <div class="lt-list">{% for ini, name, meta, last, tone, chip in people %}<a class="lt-list-item" href="#/relationships-show"><span class="lt-avatar">{{ ini }}</span><div class="lt-list-item__body"><strong>{{ name }}</strong><span>{{ meta }}</span></div><div class="lt-list-item__meta"><span class="lt-chip lt-chip--{{ tone }}">{{ chip }}</span><small>{{ last }}</small></div></a>{% endfor %}</div>
    {% endfor %}
  {% endif %}{% endcall %}
  <aside class="lt-stack">
    <article class="lt-panel"><div class="lt-panel__head"><i class="bi bi-exclamation-circle"></i><h3>Seguimiento vencido</h3><small>4</small></div><div class="lt-panel__body"><div class="lt-list">
      {% for ini, name, late in [('MO','María Ortiz','2 días de retraso'),('CR','Camila Rojas','15 días de retraso')] %}<div class="lt-list-item"><span class="lt-avatar">{{ ini }}</span><div class="lt-list-item__body"><strong>{{ name }}</strong><span>{{ late }}</span></div><button class="lt-icon-button" type="button" data-lt-static-nav aria-label="Marcar contacto con {{ name }}"><i class="bi bi-check2-circle"></i></button></div>{% endfor %}
    </div></div></article>
    <article class="lt-panel"><div class="lt-panel__head"><i class="bi bi-cake2"></i><h3>Próximos cumpleaños</h3></div><div class="lt-panel__body"><div class="lt-list">
      {% for name, when in [('Daniel Pérez','14 sep. · cumple 33'),('Laura Gómez','2 oct.')] %}<div class="lt-list-item"><span class="lt-list-item__icon"><i class="bi bi-gift"></i></span><div class="lt-list-item__body"><strong>{{ name }}</strong><span>{{ when }}</span></div></div>{% endfor %}
    </div><div class="lt-route-links"><a class="lt-button lt-button--tonal" href="#/relationships-birthdays">Ver todos</a></div></div></article>
  </aside>
</section>
{{ fab('Agregar persona', 'bi-person-plus', 'person-new', [('Agregar círculo', 'bi-plus-circle', 'circle-new'), ('Agregar etiqueta', 'bi-tag', 'tag-new')], split=True) }}
{% call dialog('person-new', 'Agregar persona', icon='bi-person-plus', sections=[('basic','Información básica','bi-person'),('contact','Contacto','bi-telephone'),('details','Detalles adicionales','bi-card-text')]) %}
<section class="lt-dialog__section" data-section="basic">
  <header class="lt-dialog__section-head"><h3>Información básica</h3></header>
  <div class="lt-form"><label class="lt-field lt-form--full"><span>Nombre completo *</span><input type="text" placeholder="Ej. Camila Rojas"></label><label class="lt-field "><span>Apodo</span><input type="text" placeholder=""></label><label class="lt-field "><span>Círculo</span><select><option>Amigos cercanos</option><option>Familia</option><option>Trabajo</option></select></label><label class="lt-field "><span>Mes de cumpleaños</span><select><option>marzo</option></select></label><label class="lt-field "><span>Día</span><input type="number" value="3"></label></div>
</section>
<section class="lt-dialog__section" data-section="contact" hidden>
  <header class="lt-dialog__section-head"><h3>Contacto</h3></header>
  <div class="lt-form"><label class="lt-field "><span>WhatsApp</span><input type="text" placeholder="+57 ..."></label><label class="lt-field "><span>Correo</span><input type="text" placeholder="nombre@correo.com"></label><label class="lt-field "><span>Ciudad</span><input type="text" placeholder=""></label><label class="lt-field "><span>Frecuencia de contacto (días)</span><input type="number" value="30"></label></div>
</section>
<section class="lt-dialog__section" data-section="details" hidden>
  <header class="lt-dialog__section-head"><h3>Detalles adicionales</h3></header>
  <div class="lt-form"><label class="lt-field lt-form--full"><span>Notas generales</span><textarea></textarea></label></div>
</section>
{% endcall %}
{% call dialog('circle-new', 'Agregar círculo', icon='bi-plus-circle') %}<div class="lt-form"><label class="lt-field lt-form--full"><span>Nombre del círculo *</span><input type="text" placeholder=""></label><label class="lt-field lt-form--full"><span>Frecuencia de contacto (días)</span><input type="number" value="30"></label></div>{% endcall %}
{% call dialog('tag-new', 'Agregar etiqueta', icon='bi-tag') %}<div class="lt-form"><label class="lt-field lt-form--full"><span>Nombre de la etiqueta *</span><input type="text" placeholder=""></label></div>{% endcall %}
{% endcall %}
