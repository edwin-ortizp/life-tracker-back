{% from '@project/components/life-shell.html.jinja' import shell, relationship_tabs, summary_card %}
{% from '@project/components/relationship-detail.html.jinja' import history_rows, history_table, type_chip, row_menu, event_actions %}
{% call shell('relationships', 'Camila Rojas', 'bi-person') %}
{{ relationship_tabs('/relationships-show') }}
<section class="lt-grid-main">
  <div class="lt-stack">
    {% call summary_card('rel-upcoming', 'Pendientes y próximos', 'bi-list-check', 'Ver todas') %}
    <table class="lt-mtable lt-mtable--upcoming">
      <thead><tr><th scope="col" class="lt-mtable__check"><span class="lt-sr-only">Completar</span></th><th scope="col">Tarea / Acontecimiento</th><th scope="col">Fecha</th><th scope="col">Tipo</th><th scope="col">Estado</th><th scope="col" class="lt-mtable__actions"><span class="lt-sr-only">Acciones</span></th></tr></thead>
      <tbody>{% for title, date, kind, state, tone in [
        ('Llamar para ponernos al día','Lun 14 sep.','Tarea','Por hacer','neutral'),
        ('Reservar restaurante para la cena','Mar 15 sep.','Tarea','Por hacer','neutral'),
        ('Cena de reencuentro','Sáb 19 sep.','Plan','Planeado','info'),
        ('Preparar detalle de cumpleaños','Vie 26 feb. 2027','Cumpleaños','Por hacer','neutral'),
        ('Enviarle el libro que le recomendé','Sin fecha','Tarea','Por hacer','neutral')
      ] %}<tr>
        <td class="lt-mtable__check"><button class="lt-mtable__check-button" type="button" data-lt-static-nav aria-label="Marcar «{{ title }}» como hecha"><span class="lt-check" aria-hidden="true"></span></button></td>
        <td class="lt-mtable__title">{{ title }}</td>
        <td class="lt-mtable__date">{{ date }}</td>
        <td class="lt-mtable__kind">{{ type_chip(kind) }}</td>
        <td class="lt-mtable__state"><span class="lt-chip lt-chip--{{ tone }}">{{ state }}</span></td>
        <td class="lt-mtable__actions">{{ row_menu('rel-upcoming-menu-' ~ loop.index, 'Acciones de ' ~ title, [('Editar','bi-pencil',false),('Marcar como hecha','bi-check2-circle',false),('Posponer','bi-calendar-plus',false),('Eliminar','bi-trash',true)]) }}</td>
      </tr>{% endfor %}</tbody>
    </table>
    {% endcall %}
    {% call summary_card('rel-history', 'Historial reciente', 'bi-clock-history', 'Ver historial completo', '/relationships-history') %}
    {{ history_table(history_rows[:5], 'rel-history') }}
    {% endcall %}
  </div>
  <aside class="lt-stack">
    <article class="lt-panel lt-panel--menu"><div class="lt-panel__head"><i class="bi bi-person"></i><h3>Información de contacto</h3>
      <div class="lt-menu-anchor"><button class="lt-icon-button lt-panel__more" type="button" data-lt-toggle="rel-contact-menu" aria-haspopup="menu" aria-expanded="false" aria-label="Acciones del contacto"><i class="bi bi-three-dots-vertical"></i></button>
        <div class="lt-menu lt-menu--down" id="rel-contact-menu" role="menu" hidden><button class="lt-menu__item" role="menuitem" type="button" data-lt-static-nav><i class="bi bi-pencil"></i> Editar contacto</button><button class="lt-menu__item" role="menuitem" type="button" data-lt-static-nav><i class="bi bi-person-vcard"></i> Gestionar alias</button><button class="lt-menu__item" role="menuitem" type="button" data-lt-static-nav><i class="bi bi-tags"></i> Cambiar círculo y etiquetas</button><hr class="lt-menu__divider"><button class="lt-menu__item lt-menu__item--danger" role="menuitem" type="button" data-lt-static-nav><i class="bi bi-archive"></i> Archivar contacto</button></div>
      </div></div><div class="lt-panel__body">
      <div class="lt-list-item"><span class="lt-avatar lt-avatar--lg">CR</span><div class="lt-list-item__body"><strong>Camila Rojas</strong><span>“Cami” · Amigos cercanos</span></div></div>
      <dl class="lt-dl"><div><dt>Cumpleaños</dt><dd>3 mar. · 31 años</dd></div><div><dt>Nos conocimos</dt><dd>2013 · Universidad</dd></div><div><dt>Ciudad</dt><dd>Medellín</dd></div><div><dt>Etiquetas</dt><dd><span class="lt-chip">Universidad</span></dd></div></dl>
    </div></article>
    <article class="lt-panel"><div class="lt-panel__head"><i class="bi bi-bar-chart"></i><h3>Estadísticas rápidas</h3></div><div class="lt-panel__body">
      <dl class="lt-quick-stats">{% for label, value, tone in [('Último contacto','Hace 48 días','warning'),('Frecuencia deseada','Cada mes','primary'),('Momentos este año','10','success'),('Planes pendientes','8','accent')] %}<div class="lt-quick-stat lt-quick-stat--{{ tone }}"><dt>{{ label }}</dt><dd>{{ value }}</dd></div>{% endfor %}</dl>
    </div></article>
    <article class="lt-panel"><div class="lt-panel__head"><i class="bi bi-telephone"></i><h3>Medios de contacto</h3></div><div class="lt-panel__body"><div class="lt-list">
      {% for icon, value, kind in [('bi-whatsapp','+57 310 555 0142','WhatsApp'),('bi-envelope','camila.rojas@correo.com','Correo'),('bi-instagram','@camirojas','Instagram')] %}<div class="lt-list-item"><span class="lt-list-item__icon"><i class="bi {{ icon }}"></i></span><div class="lt-list-item__body"><strong>{{ value }}</strong><span>{{ kind }}</span></div></div>{% endfor %}
    </div></div></article>
    <article class="lt-panel"><div class="lt-panel__head"><i class="bi bi-sticky"></i><h3>Notas</h3></div><div class="lt-panel__body"><p class="lt-page-head__subtitle">Vegetariana. Le encanta el café de especialidad y los conciertos de jazz.</p></div></article>
  </aside>
</section>
{{ event_actions() }}
{% endcall %}
