{% from '@project/components/life-shell.html.jinja' import shell, meals_tabs, metric, dialog, fab, manage_card %}
{% call shell('meals', 'Ingredientes', 'bi-basket') %}
{{ meals_tabs('/meals-ingredients') }}
<section class="lt-grid-main">
  {% call(zone) manage_card('ingredients', 'Catálogo de ingredientes', 'bi-basket', count='(14 / 86)', total=86, search='Buscar ingredientes', menu=[('Exportar CSV', 'bi-filetype-csv')], footer={'from':1,'to':14,'total':86,'noun':'ingredientes','page':1,'pages':4,'per_page':25}) %}{% if zone == 'filters' %}
      <div class="lt-popover" id="ingredients-filters" role="dialog" aria-labelledby="ingredients-filters-title" hidden><span class="lt-popover__handle" aria-hidden="true"></span>
        <div class="lt-popover__head"><h4 id="ingredients-filters-title">Filtros</h4><button class="lt-icon-button" type="button" data-lt-toggle="ingredients-filters" aria-label="Cerrar filtros"><i class="bi bi-x-lg"></i></button></div>
        <div class="lt-field"><span>Inventario</span><div class="lt-chip-row"><button class="lt-chip lt-chip--filter is-selected" type="button" data-lt-static-nav aria-pressed="true">Todos</button><button class="lt-chip lt-chip--filter" type="button" data-lt-static-nav>En stock</button><button class="lt-chip lt-chip--filter" type="button" data-lt-static-nav>Por agotarse</button><button class="lt-chip lt-chip--filter" type="button" data-lt-static-nav>Sin stock</button></div></div>
        <label class="lt-field"><span>Categoría</span><select><option>Todas</option><option>Verduras y frutas</option><option>Proteínas</option><option>Lácteos</option><option>Despensa</option><option>Especias</option></select></label>
        <div class="lt-popover__actions"><button class="lt-button lt-button--outlined" type="button" data-lt-static-nav><i class="bi bi-eraser" aria-hidden="true"></i>Limpiar</button><button class="lt-button" type="button" data-lt-toggle="ingredients-filters"><i class="bi bi-funnel-fill" aria-hidden="true"></i>Filtrar</button></div>
      </div>
    {% else %}

    {% for cat, items in [
      ('Verduras y frutas', [('Banano','6 unidades','En stock','success','Alias: guineo'),('Ahuyama','0,5 kg','Por agotarse','warning',''),('Cilantro','—','Sin stock','danger','Usado en 7 recetas'),('Limones','6 unidades','En stock','success',''),('Frutos rojos','200 g','En stock','success','')]),
      ('Proteínas', [('Pechuga de pollo','1,2 kg','En stock','success','Variantes: filete, molida'),('Lentejas','250 g','Por agotarse','warning',''),('Tilapia','—','Sin stock','danger','Necesario por una receta'),('Huevos','30 unidades','En stock','success','')]),
      ('Despensa', [('Avena en hojuelas','800 g','En stock','success',''),('Leche de coco','2 latas','En stock','success',''),('Arroz basmati','—','Sin stock','danger',''),('Café','500 g','En stock','success',''),('Harina de trigo','1 kg','En stock','success','')])
    ] %}
    <p class="lt-section-label">{{ cat }}</p>
    <div class="lt-list">{% for name, qty, chip, tone, note in items %}<button class="lt-list-item" type="button" data-lt-toggle="ingredient-new" aria-haspopup="dialog" data-ingredient="{{ name }}"><div class="lt-list-item__body"><strong>{{ name }}</strong><span>{{ qty }}{% if note %} · {{ note }}{% endif %}</span><span data-ingredient-offers>Éxito · $4.500 · Carulla · $5.200 · presentación por unidad (ejemplo)</span></div><span class="lt-chip lt-chip--{{ tone }}">{{ chip }}</span></button>{% endfor %}</div>
    {% endfor %}
  {% endif %}{% endcall %}
  <aside class="lt-stack">
    <article class="lt-panel"><div class="lt-panel__head"><i class="bi bi-pie-chart"></i><h3>Resumen</h3></div><div class="lt-panel__body">
      <div class="lt-stack-bar" role="img" aria-label="62 en stock, 14 por agotarse, 10 sin stock"><span style="--value:72%"></span><span style="--value:16%"></span><span style="--value:12%"></span></div>
      <dl class="lt-dl"><div><dt>En stock</dt><dd>62</dd></div><div><dt>Por agotarse</dt><dd>14</dd></div><div><dt>Sin stock</dt><dd>10</dd></div><div><dt>Sin usar en recetas</dt><dd>9</dd></div></dl>
    </div></article>
    <article class="lt-panel"><div class="lt-panel__head"><i class="bi bi-tags"></i><h3>Por categoría</h3></div><div class="lt-panel__body"><div class="lt-list">
      {% for c, n in [('Verduras y frutas',28),('Proteínas',14),('Lácteos',9),('Despensa',25),('Especias',10)] %}<div class="lt-list-item"><div class="lt-list-item__body"><strong>{{ c }}</strong></div><span class="lt-chip lt-chip--neutral">{{ n }}</span></div>{% endfor %}
    </div><div class="lt-route-links"><a class="lt-button lt-button--tonal" href="#/meals-shopping"><i class="bi bi-cart3"></i> Ir a compras</a></div></div></article>
  </aside>
</section>
{{ fab('Agregar ingrediente', 'bi-basket', 'ingredient-new', actions=[('Agregar en bloque', 'bi-magic', None)], split=True) }}
{% call dialog('ingredient-new', 'Agregar ingrediente', icon='bi-basket', submit_action='save-ingredient', sections=[('basic','Información básica','bi-basket'),('inventory','Inventario','bi-box-seam'),('variants','Variantes','bi-box'),('prices','Precios por tienda','bi-shop'),('aliases','Alias y equivalencias','bi-tags')]) %}
<section class="lt-dialog__section" data-section="basic">
  <header class="lt-dialog__section-head"><h3>Información básica</h3></header>
  <div class="lt-form"><label class="lt-field lt-form--full"><span>Nombre *</span><input data-ingredient-name type="text" required placeholder="Ej. Aguacate"></label><label class="lt-field "><span>Categoría</span><select><option>Frutas y verduras</option><option>Lácteos y huevos</option></select></label><label class="lt-field "><span>Unidad base</span><input type="text" placeholder="unidades"></label></div>
</section>
<section class="lt-dialog__section" data-section="inventory" hidden>
  <header class="lt-dialog__section-head"><h3>Inventario</h3></header>
  <div class="lt-form"><label class="lt-field "><span>Stock</span><input type="number" value="0"></label><label class="lt-field "><span>Por comprar</span><input type="number" value="2"></label></div>
</section>
<section class="lt-dialog__section" data-section="variants" hidden>
  <header class="lt-dialog__section-head"><h3>Variantes</h3></header>
  <div data-ingredient-variants class="lt-stack"></div>
  <button class="lt-button lt-button--tonal" type="button" data-ingredient-add-variant><i class="bi bi-plus-lg" aria-hidden="true"></i> Agregar variante</button>
</section>
<section class="lt-dialog__section" data-section="prices" hidden>
  <header class="lt-dialog__section-head"><h3>Precios por tienda</h3></header>
  <div data-ingredient-prices class="lt-stack"></div>
  <button class="lt-button lt-button--tonal" type="button" data-ingredient-add-price><i class="bi bi-plus-lg" aria-hidden="true"></i> Agregar precio</button>
  <p data-ingredient-price-error role="status"></p>
</section>
<template data-ingredient-variant-template>
  <article class="lt-ingredient-editor-card"><header><strong data-variant-title></strong><button class="lt-icon-button" type="button" data-remove-variant aria-label="Quitar variante"><i class="bi bi-trash" aria-hidden="true"></i></button></header><div class="lt-form">
    {% for key, label, type in [('brand','Marca','text'),('packaging','Empaque','text'),('content','Contenido','number'),('content_unit','Unidad del contenido','text'),('units_per_pack','Unidades por paquete','number'),('kcal','Calorías propias','number'),('barcode','Código de barras','text')] %}
    <label class="lt-field"><span>{{ label }}</span><input data-variant-field="{{ key }}" type="{{ type }}"{% if type == 'number' %} min="{{ 1 if key == 'units_per_pack' else 0 }}" step="{{ 1 if key == 'units_per_pack' else 'any' }}"{% endif %}></label>
    {% endfor %}
  </div></article>
</template>
<template data-ingredient-price-template>
  <article class="lt-ingredient-editor-card"><header><strong>Precio por tienda</strong><button class="lt-icon-button" type="button" data-remove-price aria-label="Quitar precio"><i class="bi bi-trash" aria-hidden="true"></i></button></header><div class="lt-form">
    <label class="lt-field lt-form--full"><span>Variante</span><select data-price-field="variant" required></select></label>
    <label class="lt-field"><span>Tienda</span><input data-price-field="store" required></label>
    <label class="lt-field"><span>Precio</span><input data-price-field="amount" type="number" min="0" step="0.01" required></label>
    <label class="lt-field"><span>Fuente del precio</span><select data-price-field="source" required><option value="">Seleccionar</option><option value="manual">Manual</option><option value="web">Web</option><option value="ticket">Ticket</option></select></label>
    <label class="lt-field"><span>Fecha</span><input data-price-field="date" type="date" required></label>
    <label><input data-price-field="verified" type="checkbox"> Verificado</label>
  </div></article>
</template>
<section class="lt-dialog__section" data-section="aliases" hidden>
  <header class="lt-dialog__section-head"><h3>Alias y equivalencias</h3></header>
  <div class="lt-form"><label class="lt-field "><span>Alias 1</span><input type="text" placeholder="palta"></label></div>
</section>
{% endcall %}
{% endcall %}
