{% from '@project/components/life-shell.html.jinja' import shell, meals_tabs, dialog, fab %}
{% call shell('meals', 'Planificación de comidas', 'bi-egg-fried') %}
{{ meals_tabs('/meals-weekly') }}
<section class="lt-toolbar"><button class="lt-icon-button" type="button" data-lt-static-nav aria-label="Semana anterior"><i class="bi bi-chevron-left"></i></button><p class="lt-toolbar__label">Semana del 8 al 14 de septiembre</p><button class="lt-icon-button" type="button" data-lt-static-nav aria-label="Semana siguiente"><i class="bi bi-chevron-right"></i></button></section>
<section class="lt-week-plan" aria-label="Plan semanal">
  {% set plan = [
    ('Lun','8',[('Desayuno','Avena con banano'),('Onces (mañana)',''),('Almuerzo','Pollo al curry'),('Merienda (tarde)',''),('Cena','Ensalada César')]),
    ('Mar','9',[('Desayuno','Huevos pericos'),('Onces (mañana)',''),('Almuerzo','Pollo al curry'),('Merienda (tarde)',''),('Cena','Crema de ahuyama')]),
    ('Mié','10',[('Desayuno','Avena con banano'),('Onces (mañana)',''),('Almuerzo','Lentejas con arroz'),('Merienda (tarde)',''),('Cena','Tacos de pescado')]),
    ('Jue','11',[('Desayuno','Arepa con queso'),('Onces (mañana)',''),('Almuerzo','Lentejas con arroz'),('Merienda (tarde)',''),('Cena','')]),
    ('Vie','12',[('Desayuno','Yogur con granola'),('Onces (mañana)',''),('Almuerzo','Salmón al horno'),('Merienda (tarde)',''),('Cena','Pizza casera')]),
    ('Sáb','13',[('Desayuno','Calentado'),('Onces (mañana)',''),('Almuerzo',''),('Merienda (tarde)',''),('Cena','')]),
    ('Dom','14',[('Desayuno','Pancakes de avena'),('Onces (mañana)',''),('Almuerzo','Ajiaco'),('Merienda (tarde)',''),('Cena','')])
  ] %}
  <div class="lt-meal-row-labels" aria-label="Tipos de comida"><span aria-hidden="true"></span>{% for label in ['Desayuno','Onces (mañana)','Almuerzo','Merienda (tarde)','Cena','Planeado / consumido'] %}<span class="lt-meal-row-label">{{ label }}</span>{% endfor %}</div>
  {% for dname, dnum, slots in plan %}
  <div class="lt-day-col{% if dnum == '10' %} is-today{% endif %}"><h4>{{ dname }} <small>{{ dnum }}{% if dnum == '10' %} · hoy{% endif %}</small></h4>
    {% for slot, recipe in slots %}<div class="lt-meal-card"><button class="lt-meal-slot{% if not recipe %} lt-meal-slot--empty{% endif %}" type="button" data-lt-toggle="meal-composition" data-meal-key="{{ dnum }}-{{ loop.index }}" data-meal-label="{{ slot }} · {{ dname }} {{ dnum }} de septiembre" data-meal-recipe="{{ recipe }}" aria-haspopup="dialog" aria-label="{{ slot }} · {{ dname }} {{ dnum }} de septiembre"><span data-meal-caption>{% if recipe %}{{ recipe }}{% else %}<span class="lt-meal-add-label"><i class="bi bi-plus-lg" aria-hidden="true"></i> Agregar</span>{% endif %}</span><small class="lt-chip lt-meal-status-chip" data-meal-state="{{ 'planned' if recipe else 'empty' }}" data-meal-status-label>{{ 'Planeada' if recipe else 'Sin planificar' }}</small></button><div class="lt-menu-anchor lt-meal-card__actions">
      <button class="lt-icon-button" type="button" data-lt-toggle="meal-menu-{{ dnum }}-{{ loop.index }}" aria-haspopup="menu" aria-expanded="false" aria-label="Acciones de {{ slot }} del {{ dnum }}"><i class="bi bi-three-dots-vertical" aria-hidden="true"></i></button>
      <div class="lt-menu lt-menu--down" id="meal-menu-{{ dnum }}-{{ loop.index }}" role="menu" hidden>
        {% for action, label, icon in [('move','Mover','bi-arrow-right'),('copy','Copiar','bi-copy'),('swap','Intercambiar','bi-arrow-left-right'),('delete','Eliminar','bi-trash')] %}<button class="lt-menu__item" type="button" role="menuitem" data-meal-open-action="{{ action }}" data-lt-toggle="meal-action-dialog"><i class="bi {{ icon }}" aria-hidden="true"></i>{{ label }}</button>{% endfor %}
      </div>
    </div></div>{% endfor %}
    <div class="lt-meal-day-totals" data-meal-day-totals="{{ dnum }}"><strong data-day-planned>—</strong><small data-day-consumed>0 kcal consumidas</small></div>
  </div>
  {% endfor %}
  <p class="lt-meal-week-summary" data-meal-week-summary aria-live="polite"></p>
</section>
<section>
  <article class="lt-panel lt-panel--accent"><div class="lt-panel__head"><i class="bi bi-sun"></i><h3>Hoy · miércoles 10</h3></div><div class="lt-panel__body"><div class="lt-list">
    {% for slot, recipe, meta in [('Desayuno','Avena con banano','10 min · 1 porción'),('Almuerzo','Lentejas con arroz','45 min · sobra para mañana'),('Cena','Tacos de pescado','25 min · 2 porciones')] %}<div class="lt-list-item"><span class="lt-list-item__icon"><i class="bi bi-egg-fried"></i></span><div class="lt-list-item__body"><strong>{{ recipe }}</strong><span>{{ slot }} · {{ meta }}</span></div><a class="lt-button lt-button--text" href="#/meals-recipes">Ver receta</a></div>{% endfor %}
  </div></div></article>

</section>
{{ fab('Generar lista de compras', 'bi-cart-plus', 'meal-generate-shopping') }}
{% call dialog('meal-generate-shopping', 'Generar lista de compras', submit='Generar', icon='bi-cart-plus') %}
  <p>Semana del 8 al 14 de septiembre</p>
  <p>Generar la lista a partir de las comidas planificadas.</p>
{% endcall %}
{% call dialog('meal-composition', 'Composición de la comida', icon='bi-egg-fried', submit='Guardar', submit_action='save-meal', sections=[('composition','Ingredientes','bi-basket'),('nutrition','Resumen nutricional','bi-heart-pulse'),('notes','Notas','bi-journal-text')]) %}
<section class="lt-dialog__section" data-section="composition">
  <div class="lt-meal-status-row">
    <span>Estado de la comida</span>
    <div class="lt-menu-anchor">
      <div class="lt-split">
        <button class="lt-button lt-split__main" type="button" data-meal-status data-lt-toggle="meal-status-menu" aria-haspopup="menu" aria-expanded="false">Planeada</button>
        <button class="lt-button lt-split__toggle" type="button" data-lt-toggle="meal-status-menu" aria-haspopup="menu" aria-expanded="false" aria-label="Cambiar estado de la comida"><i class="bi bi-chevron-down" aria-hidden="true"></i></button>
      </div>
      <div class="lt-menu lt-menu--down" id="meal-status-menu" role="menu" hidden>
        <button class="lt-menu__item" type="button" role="menuitem" data-meal-set-status="planned">Volver a planeada</button>
        <button class="lt-menu__item" type="button" role="menuitem" data-meal-set-status="home">Marcar como consumida</button>
        <button class="lt-menu__item" type="button" role="menuitem" data-meal-set-status="outside">Registrar comida por fuera</button>
      </div>
    </div>
  </div>
  <p data-meal-status-message role="status"></p>
  <div data-meal-outside hidden>
    <label class="lt-field"><span>Notas de comida por fuera</span><input data-meal-outside-notes maxlength="5000" placeholder="Ej. Almuerzo en un restaurante"></label>
    <label class="lt-field"><span>Calorías consumidas por fuera (opcional)</span><input data-meal-outside-calories type="number" min="0" step="1" placeholder="Sin registrar"></label>
    <p>El plan original se conserva. Puedes registrar una comida por fuera sin añadir elementos.</p>
  </div>
  <header class="lt-dialog__section-head"><h3>Composición de la comida</h3></header>
  <div data-meal-items aria-label="Elementos de la comida"></div>
  <button class="lt-button lt-button--tonal" type="button" data-meal-add><i class="bi bi-plus-lg" aria-hidden="true"></i> Agregar</button>
  <p data-meal-error role="status"></p>
  <template data-meal-row-template>
    <div class="lt-meal-composer">
      <label class="lt-field"><span>Tipo</span><select data-meal-kind required><option value="">Seleccionar</option><option value="recipe">Receta</option><option value="ingredient">Ingrediente</option><option value="free">Elemento libre</option></select></label>
      <label class="lt-field" data-meal-name-field><span>Elemento</span><select data-meal-choice required disabled><option value="">Selecciona el tipo</option></select><input data-meal-free hidden disabled required maxlength="120" placeholder="Nombre del elemento"></label>
      <label class="lt-field"><span>Cantidad</span><input data-meal-quantity required type="number" min="0.1" step="any" placeholder="Cantidad"></label>
      <label class="lt-field"><span>Unidad</span><select data-meal-unit required><option value="">Seleccionar</option><option>porción</option><option>g</option><option>ml</option><option>unidad</option></select></label>
      <button class="lt-icon-button" type="button" data-meal-remove aria-label="Quitar elemento"><i class="bi bi-trash" aria-hidden="true"></i></button>
    </div>
  </template>
</section>
<section class="lt-dialog__section" data-section="nutrition" hidden>
  <header class="lt-dialog__section-head"><h3>Resumen nutricional</h3></header>
  <label class="lt-field"><span>Calorías manuales (kcal)</span><input data-meal-calories-override type="number" min="0" step="1" placeholder="Usar cálculo de la composición"></label>
  <div class="lt-metrics" data-meal-nutrition></div>
  <p data-meal-nutrition-note></p>
</section>
<section class="lt-dialog__section" data-section="notes" hidden>
  <header class="lt-dialog__section-head"><h3>Notas de preparación</h3></header>
  <div class="lt-field">
    <span id="meal-notes-label">Notas</span>
    <div class="lt-md-editor">
      <div class="lt-md-editor__toolbar" role="toolbar" aria-label="Formato de las notas">
        {% for action, label, icon in [('bold','Negrita','bi-type-bold'),('italic','Cursiva','bi-type-italic'),('link','Enlace','bi-link-45deg'),('unordered','Lista con viñetas','bi-list-ul'),('ordered','Lista numerada','bi-list-ol')] %}
        <button class="lt-md-editor__tool" type="button" data-meal-markdown="{{ action }}" aria-label="{{ label }}"><i class="bi {{ icon }}" aria-hidden="true"></i></button>
        {% if action in ['italic','link'] %}<span class="lt-md-editor__sep" aria-hidden="true"></span>{% endif %}
        {% endfor %}
        <span class="lt-md-editor__hint"><i class="bi bi-question-circle" aria-hidden="true"></i> Markdown</span>
      </div>
      <textarea data-meal-notes rows="8" aria-labelledby="meal-notes-label" placeholder="Ej. Dejar la avena en remojo desde la noche anterior."></textarea>
    </div>
  </div>
</section>
{% endcall %}
{% call dialog('meal-action-dialog', 'Acciones de la comida', submit='Confirmar', icon='bi-arrow-left-right', submit_action='run-meal-action') %}
  <p data-meal-action-source></p>
  <div data-meal-action-target>
    <label class="lt-field"><span>Fecha destino</span><input type="date" data-meal-target-date min="2026-09-08" max="2026-09-14" required></label>
    <label class="lt-field"><span>Comida destino</span><select data-meal-target-type><option value="1">Desayuno</option><option value="2">Onces (mañana)</option><option value="3">Almuerzo</option><option value="4">Merienda (tarde)</option><option value="5">Cena</option></select></label>
  </div>
  <p data-meal-delete-confirm hidden>¿Eliminar esta comida planificada?</p>
  <p data-meal-action-error role="status"></p>
{% endcall %}
{% endcall %}
