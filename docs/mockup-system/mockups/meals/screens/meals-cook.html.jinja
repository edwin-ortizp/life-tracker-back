{% from '@project/components/life-shell.html.jinja' import shell, meals_tabs, dialog, manage_card, row_split %}
{% set recipes = [
('pancakes','🥞','Pancakes de avena','15 min',2,[('Avena en hojuelas',120,800,'g'),('Huevos',2,30,'unidades'),('Frutos rojos',100,200,'g')]),
('curry','🍛','Pollo al curry','40 min',4,[('Pechuga de pollo',600,1200,'g'),('Leche de coco',1,2,'latas'),('Arroz basmati',300,0,'g')]),
('lentils','🥣','Lentejas con arroz','45 min',6,[('Lentejas',500,250,'g'),('Arroz basmati',300,0,'g')])
] %}
{% call shell('meals','Qué cocinar','bi-egg-fried') %}
{{ meals_tabs('/meals-cook') }}
{% call(zone) manage_card('meal-cook-list','Qué cocinar','bi-egg-fried',search='Buscar qué cocinar') %}{% if zone == 'filters' %}
<div class="lt-popover" id="meal-cook-list-filters" role="dialog" aria-labelledby="meal-cook-list-filters-title" hidden><span class="lt-popover__handle" aria-hidden="true"></span>
  <div class="lt-popover__head"><h4 id="meal-cook-list-filters-title">Disponibilidad</h4><button class="lt-icon-button" type="button" data-lt-toggle="meal-cook-list-filters" aria-label="Cerrar filtros"><i class="bi bi-x-lg" aria-hidden="true"></i></button></div>
<fieldset class="lt-cook-radio-group"><legend class="lt-sr-only">Disponibilidad de ingredientes</legend>
{% for key,label,selected in [('ready','Puedo cocinar',true),('missing','Me faltan ingredientes',false),('all','Todas',false)] %}<label class="lt-cook-radio"><input type="radio" name="cook-availability" value="{{ key }}" data-cook-filter="{{ key }}"{% if selected %} checked{% endif %}><span>{{ label }}</span></label>{% endfor %}
</fieldset>
  <div class="lt-popover__actions"><button class="lt-button" type="button" data-lt-toggle="meal-cook-list-filters"><i class="bi bi-check-lg" aria-hidden="true"></i> Listo</button></div>
</div>
{% else %}

<div class="lt-meal-table-scroll"><table class="lt-mtable"><thead><tr><th scope="col">Receta</th><th scope="col">Tiempo</th><th scope="col">Porciones</th><th scope="col">Disponibilidad</th><th scope="col">Ingredientes faltantes</th><th scope="col">Acciones</th></tr></thead><tbody>
{% for key,emoji,name,time,portions,ingredients in recipes %}
{% set status=namespace(missing=0) %}{% for ingredient,needed,stock,unit in ingredients %}{% if stock < needed %}{% set status.missing=status.missing+1 %}{% endif %}{% endfor %}
<tr data-cook-card data-cook-state="{{ 'missing' if status.missing else 'ready' }}" data-cook-name="{{ name }}"{% if status.missing %} hidden{% endif %}>
<td data-label="Receta"><strong>{{ name }}</strong></td><td data-label="Tiempo">{{ time }}</td><td data-label="Porciones">{{ portions }}</td><td data-label="Disponibilidad"><span class="lt-chip lt-chip--{{ 'warning' if status.missing else 'success' }}">{{ 'Faltan ingredientes' if status.missing else 'Stock suficiente' }}</span></td>
<td data-label="Ingredientes faltantes">{% if status.missing %}{% for ingredient,needed,stock,unit in ingredients %}{% if stock < needed %}<span class="lt-recipe-description">{{ ingredient }}: {{ needed-stock }} {{ unit }}</span>{% endif %}{% endfor %}{% else %}—{% endif %}</td>
<td data-label="Acciones">{{ row_split('cook-actions-' ~ key, 'Ver ingredientes', [], name, dialog='cook-' ~ key) }}</td></tr>
{% endfor %}
</tbody></table></div><p class="lt-cook-hint" data-cook-empty role="status" hidden>No hay recetas que coincidan con esta búsqueda y disponibilidad.</p>
{% endif %}{% endcall %}
{% for key,emoji,name,time,portions,ingredients in recipes %}{% call dialog('cook-' ~ key,name,submit='Cerrar',icon='bi-egg-fried') %}
<p>{{ portions }} porciones · {{ time }}</p><div class="lt-list">{% for ingredient,needed,stock,unit in ingredients %}<div class="lt-list-item"><div class="lt-list-item__body"><a class="lt-link" href="#/meals-ingredients?ingredient={{ ingredient|urlencode }}">{{ ingredient }}</a><span>Necesitas {{ needed }} {{ unit }} · Tienes {{ stock }} {{ unit }}</span></div><span class="lt-chip lt-chip--{{ 'success' if stock >= needed else 'warning' }}">{% if stock >= needed %}Disponible{% else %}Faltan {{ needed-stock }} {{ unit }}{% endif %}</span></div>{% endfor %}</div>
{% endcall %}{% endfor %}
{% endcall %}
