{% from '@project/components/life-shell.html.jinja' import shell, meals_tabs, metric, dialog, fab, manage_card %}
{% set offers = {
'Cilantro': {'stores':['Éxito','Carulla'], 'amount':2500},
'Ahuyama': {'stores':['Éxito','D1'], 'amount':5000},
'Repollo morado': {'stores':['Carulla'], 'amount':none},
'Limones': {'stores':['Éxito','D1'], 'amount':4000},
'Tilapia': {'stores':['Éxito','Carulla'], 'amount':18000},
'Salmón': {'stores':['Carulla'], 'amount':24000},
'Huevos': {'stores':['D1','Éxito'], 'amount':18000},
'Arroz basmati': {'stores':['Éxito','Carulla'], 'amount':14500},
'Harina de trigo': {'stores':['D1','Éxito'], 'amount':none},
'Café': {'stores':['D1','Éxito'], 'amount':15000}
} %}
{% set estimate = namespace(total=0, missing=0) %}
{% for name in ['Cilantro','Ahuyama','Repollo morado','Tilapia','Salmón','Arroz basmati','Harina de trigo'] %}{% if offers[name].amount is none %}{% set estimate.missing = estimate.missing + 1 %}{% else %}{% set estimate.total = estimate.total + offers[name].amount %}{% endif %}{% endfor %}
{% call shell('meals', 'Lista de compras', 'bi-cart3') %}
{{ meals_tabs('/meals-shopping') }}
<section class="lt-grid-main">
  {% call(zone) manage_card('shopping', 'Por comprar', 'bi-cart3', count='(10 / 18)', total=18, search='Buscar en lista de compras', menu=[('Exportar CSV', 'bi-filetype-csv'), ('Imprimir lista', 'bi-printer')], footer={'from':1,'to':10,'total':18,'noun':'productos','page':1,'pages':1,'per_page':25}) %}{% if zone == 'filters' %}
      <div class="lt-popover" id="shopping-filters" role="dialog" aria-labelledby="shopping-filters-title" hidden><span class="lt-popover__handle" aria-hidden="true"></span>
        <div class="lt-popover__head"><h4 id="shopping-filters-title">Filtros</h4><button class="lt-icon-button" type="button" data-lt-toggle="shopping-filters" aria-label="Cerrar filtros"><i class="bi bi-x-lg"></i></button></div>
        <div class="lt-field"><span>Estado</span><div class="lt-chip-row"><button class="lt-chip lt-chip--filter is-selected" type="button" data-lt-static-nav aria-pressed="true">Pendientes</button><button class="lt-chip lt-chip--filter" type="button" data-lt-static-nav>Comprados</button><button class="lt-chip lt-chip--filter" type="button" data-lt-static-nav>Por receta</button></div></div>
        <label class="lt-field"><span>Pasillo</span><select><option>Todos</option><option>Verduras y frutas</option><option>Proteínas</option><option>Despensa</option></select></label>
        <div class="lt-popover__actions"><button class="lt-button lt-button--outlined" type="button" data-lt-static-nav><i class="bi bi-eraser" aria-hidden="true"></i>Limpiar</button><button class="lt-button" type="button" data-lt-toggle="shopping-filters"><i class="bi bi-funnel-fill" aria-hidden="true"></i>Filtrar</button></div>
      </div>
    {% else %}

    <div class="lt-shopping-info" role="status"><i class="bi bi-info-circle" aria-hidden="true"></i><div>Total estimado por comprar: <strong>$ {{ '{:,.0f}'.format(estimate.total).replace(',', '.') }}</strong> · <strong>{{ estimate.missing }} artículos sin precio</strong><small>Precios ilustrativos para las cantidades pendientes; los artículos sin precio no se incluyen en el total.</small></div></div>
    {% for cat, items in [
      ('Verduras y frutas', [('Cilantro','1 atado','Tacos de pescado',false),('Ahuyama','1 kg','Crema de ahuyama',false),('Repollo morado','1/2 unidad','Tacos de pescado',false),('Limones','6 unidades','',true)]),
      ('Proteínas', [('Tilapia','500 g','Tacos de pescado',false),('Salmón','400 g','Salmón al horno',false),('Huevos','30 unidades','',true)]),
      ('Despensa', [('Arroz basmati','1 kg','Pollo al curry',false),('Harina de trigo','1 kg','Pizza casera',false),('Café','500 g','',true)])
    ] %}
    <p class="lt-section-label">{{ cat }}</p>
    <div class="lt-list">{% for name, qty, recipe, done in items %}<div class="lt-list-item"><span class="lt-check{% if done %} is-done{% endif %}" title="Marcar como comprado">{% if done %}✓{% endif %}</span><div class="lt-list-item__body"><strong>{{ name }}</strong><span>{{ qty }}{% if done %} · comprado{% endif %}</span><div class="lt-chip-row lt-shopping-stores" aria-label="Tiendas que venden {{ name }}">{% for store in offers[name].stores %}<span class="lt-chip lt-chip--neutral"><i class="bi bi-shop" aria-hidden="true"></i> {{ store }}</span>{% endfor %}</div><span>{% if offers[name].amount is none %}Sin precio{% else %}Estimado: $ {{ '{:,.0f}'.format(offers[name].amount).replace(',', '.') }}{% endif %}</span></div>{% if recipe %}<span class="lt-chip lt-chip--neutral" title="Necesario por una receta"><i class="bi bi-book"></i>&nbsp;{{ recipe }}</span>{% endif %}<button class="lt-icon-button" type="button" data-lt-static-nav aria-label="Ver tiendas y precios de {{ name }}"><i class="bi bi-shop"></i></button></div>{% endfor %}</div>
    {% endfor %}
  {% endif %}{% endcall %}
  <aside class="lt-stack">
    <article class="lt-panel"><div class="lt-panel__head"><i class="bi bi-receipt"></i><h3>Resumen</h3></div><div class="lt-panel__body">
      <div class="lt-progress"><span style="width:22%"></span></div>
      <dl class="lt-dl"><div><dt>Comprados</dt><dd>4 de 18</dd></div><div><dt>Costo estimado</dt><dd>$ {{ '{:,.0f}'.format(estimate.total).replace(',', '.') }}</dd></div><div><dt>Tienda sugerida</dt><dd>Éxito Calle 80</dd></div><div><dt>Por recetas</dt><dd>9 ítems</dd></div></dl>
      <div class="lt-route-links"><a class="lt-button lt-button--tonal" href="#/meals-weekly">Ver planificación</a></div>
    </div></article>
  </aside>
</section>
{{ fab('Agregar a compras', 'bi-cart-plus', 'shopping-new') }}
{% call dialog('shopping-new', 'Agregar a compras', icon='bi-cart-plus', sections=[('basic','Información básica','bi-cart3'),('store','Tienda y precio','bi-shop')]) %}
<section class="lt-dialog__section" data-section="basic">
  <header class="lt-dialog__section-head"><h3>Información básica</h3></header>
  <div class="lt-form"><label class="lt-field lt-form--full"><span>Nombre *</span><input type="text" placeholder="Ej. aguacate"></label><label class="lt-field "><span>Cantidad</span><input type="number" value="2"></label><label class="lt-field "><span>Unidad</span><select><option>unidades</option><option>kg</option><option>g</option><option>L</option></select></label></div>
</section>
<section class="lt-dialog__section" data-section="store" hidden>
  <header class="lt-dialog__section-head"><h3>Tienda y precio</h3></header>
  <div class="lt-form"><label class="lt-field "><span>Tienda</span><input type="text" placeholder="Éxito Calle 80"></label><label class="lt-field "><span>Precio</span><input type="number" value=""></label></div>
</section>
{% endcall %}
{% endcall %}
