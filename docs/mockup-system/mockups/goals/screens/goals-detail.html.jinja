{% from '@project/components/life-shell.html.jinja' import shell, tabs as module_tabs, header, metric %}
{% call shell('goals', 'Detalle de objetivo', 'bi-bullseye') %}
{{ header('Detalle de objetivo', 'Progreso, hitos y acciones de seguimiento.', 'bi-bullseye', '/goals-index') }}
{{ module_tabs([('Objetivos','/goals-index','bi-flag'),('Detalle','/goals-detail','bi-bullseye')], '/goals-detail') }}
<section class="lt-metrics">{{ metric('Avance','68 %','success') }}{{ metric('Próximo hito','8 km') }}{{ metric('Fecha objetivo','12 oct') }}</section>
<section class="lt-grid-2"><article class="lt-panel lt-panel--accent"><div class="lt-panel__head"><i class="bi bi-bullseye"></i><h3>Correr 10K</h3><small>En progreso</small></div><div class="lt-panel__body"><div class="lt-progress"><span style="width:68%"></span></div><p class="lt-page-head__subtitle">Construir resistencia para completar una carrera de 10 kilómetros.</p><div class="lt-route-links"><button class="lt-button" type="button" data-lt-static-nav><i class="bi bi-plus-lg"></i> Registrar avance</button></div></div></article><article class="lt-panel"><div class="lt-panel__head"><i class="bi bi-signpost-split"></i><h3>Hitos</h3></div><div class="lt-panel__body"><div class="lt-list"><div class="lt-list-item"><span class="lt-check is-done">✓</span><div class="lt-list-item__body"><strong>Completar 5 km</strong><span>Alcanzado el 2 sep.</span></div></div><div class="lt-list-item"><span class="lt-check"></span><div class="lt-list-item__body"><strong>Completar 8 km</strong><span>Próximo hito</span></div></div></div></div></article></section>
{% endcall %}