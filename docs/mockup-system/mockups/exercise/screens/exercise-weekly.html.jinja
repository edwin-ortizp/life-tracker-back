{% from '@project/components/life-shell.html.jinja' import shell, tabs as module_tabs, header, metric %}
{% call shell('exercise', 'Resumen semanal', 'bi-bar-chart-line') %}
{{ header('Resumen semanal', 'Semana del 8 al 14 de septiembre.', 'bi-bar-chart-line') }}
{{ module_tabs([('Registro diario','/exercise-daily','bi-activity'),('Resumen semanal','/exercise-weekly','bi-bar-chart-line')], '/exercise-weekly') }}
<section class="lt-metrics">{{ metric('Minutos activos','185 de 300','warning') }}{{ metric('Calorías','1.480 kcal') }}{{ metric('Días activos','3 de 7','success') }}</section>
<section class="lt-grid-2">
  <article class="lt-panel lt-panel--accent"><div class="lt-panel__head"><i class="bi bi-bar-chart-line"></i><h3>Minutos por día</h3><small>Meta 45 min/día</small></div><div class="lt-panel__body">
    <div class="lt-bars">{% for day, v in [('Lun',100),('Mar',55),('Mié',100),('Jue',0),('Vie',0),('Sáb',0),('Dom',0)] %}<div class="lt-bars__col"><div class="lt-bars__track"><span class="lt-bars__fill" style="--value:{{ v }}%"></span></div><span>{{ day }}</span></div>{% endfor %}</div>
  </div></article>
  <article class="lt-panel"><div class="lt-panel__head"><i class="bi bi-pie-chart"></i><h3>Por tipo de actividad</h3></div><div class="lt-panel__body"><div class="lt-list">
    {% for icon, name, detail, pct in [('bi-person-walking','Correr','2 sesiones · 11,4 km',45),('bi-universal-access','Fuerza','2 sesiones · 14 ejercicios',40),('bi-bicycle','Bicicleta','1 sesión · 12 km',15)] %}
    <div class="lt-list-item"><span class="lt-list-item__icon"><i class="bi {{ icon }}"></i></span><div class="lt-list-item__body"><strong>{{ name }}</strong><span>{{ detail }}</span><div class="lt-progress"><span style="width:{{ pct }}%"></span></div></div><span class="lt-chip">{{ pct }} %</span></div>
    {% endfor %}
  </div></div></article>
</section>
<section class="lt-panel"><div class="lt-panel__head"><i class="bi bi-trophy"></i><h3>Récords y progreso</h3></div><div class="lt-panel__body"><div class="lt-list">
  {% for name, detail, chip, tone in [('Sentadilla con barra','60 kg × 8 · +5 kg frente a agosto','Récord','success'),('Correr 5 km','30:45 · mejor tiempo del mes','Récord','success'),('Press de banca','45 kg × 10 · igual que la semana pasada','Estable','neutral')] %}
  <div class="lt-list-item"><div class="lt-list-item__body"><strong>{{ name }}</strong><span>{{ detail }}</span></div><span class="lt-chip lt-chip--{{ tone }}">{{ chip }}</span></div>
  {% endfor %}
</div></div></section>
{% endcall %}
