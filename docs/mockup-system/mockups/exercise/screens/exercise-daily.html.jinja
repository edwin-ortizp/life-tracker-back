{% from '@project/components/life-shell.html.jinja' import shell, tabs as module_tabs, header, goal_calendar, dialog, fab, manage_card, row_split, applied_filters, date_filters %}
{% call shell('exercise', 'Ejercicio', 'bi-activity') %}
{{ header('Ejercicio', 'Actividad, esfuerzo y progreso físico · Miércoles 10 sep.', 'bi-activity') }}
{{ module_tabs([('Registro diario','/exercise-daily','bi-activity'),('Estadísticas','/exercise-statistics','bi-bar-chart-line'),('Ajustes','/exercise-settings','bi-sliders')], '/exercise-daily') }}
<section class="lt-grid-main">
  {% call(zone) manage_card('exercise-log', 'Actividades del día', 'bi-list-ul', count='(3 / 64)', total=64, search='Buscar actividades', filters=1, menu=[('Exportar CSV', 'bi-filetype-csv'), ('Ver estadísticas', 'bi-bar-chart-line')], footer={'from':1,'to':3,'total':3,'noun':'registros','page':1,'pages':1,'per_page':25}, footer_all={'to':25,'total':64,'pages':3}, sort=[('recent','Más reciente','bi-sort-down'),('oldest','Más antiguo','bi-sort-up'),('duration','Mayor duración','bi-stopwatch'),('calories','Más calorías','bi-fire')]) %}{% if zone == 'filters' %}
    {% call date_filters('exercise-log') %}<div class="lt-field"><span>Tipo</span><div class="lt-chip-row">{% for t in ['Todos','Cardio','Fuerza','Deportes','Flexibilidad'] %}<button class="lt-chip lt-chip--filter{% if loop.first %} is-selected{% endif %}" type="button" data-lt-static-nav aria-pressed="{{ 'true' if loop.first else 'false' }}">{{ t }}</button>{% endfor %}</div></div>{% endcall %}
  {% else %}
    {{ applied_filters([('bi-calendar-event','Fecha: Hoy')]) }}
    <table class="lt-mtable">
      <thead><tr><th scope="col">Fecha</th><th scope="col">Hora</th><th scope="col">Actividad</th><th scope="col">Detalle</th><th scope="col">Calorías</th><th scope="col" class="lt-mtable__actions">Acciones</th></tr></thead>
      <tbody>
      {% set iso = {'Hoy':'2026-09-10','9 sep.':'2026-09-09','8 sep.':'2026-09-08','7 sep.':'2026-09-07'} %}
      {% set mins = [45,40,32,45,30,40,60] %}
      {% for date, time, icon, name, detail, kcal, old in [('Hoy','18:35','bi-universal-access','Press de banca','4 series × 10 reps · 45 kg','124 kcal',false),('Hoy','18:10','bi-universal-access','Sentadilla con barra','4 series × 8 reps · 60 kg','140 kcal',false),('Hoy','06:40','bi-person-walking','Correr','5,2 km · 32 min · ritmo 6:09/km','348 kcal',false),('9 sep.','19:00','bi-person-walking','Caminar','3,1 km · 45 min','198 kcal',true),('9 sep.','07:10','bi-flower1','Yoga','30 min','125 kcal',true),('8 sep.','18:30','bi-bicycle','Bicicleta estática','40 min','320 kcal',true),('7 sep.','10:00','bi-dribbble','Fútbol','60 min','490 kcal',true)] %}
        <tr data-sort-at="{{ iso[date] }}T{{ time }}" data-sort-duration="{{ mins[loop.index0] }}" data-sort-calories="{{ kcal|replace(' kcal','') }}"{% if old %} data-lt-outside-filter{% endif %}>
          <td class="lt-mtable__date" data-label="Fecha">{{ date }}</td>
          <td class="lt-mtable__time" data-label="Hora">{{ time }}</td>
          <td class="lt-mtable__type" data-label="Actividad"><i class="bi {{ icon }} lt-mtable__icon" aria-hidden="true"></i> {{ name }}</td>
          <td class="lt-mtable__comment" data-label="Detalle">{{ detail }}</td>
          <td data-label="Calorías">{{ kcal }}</td>
          <td class="lt-mtable__actions">{{ row_split('exercise-log-menu-' ~ loop.index, 'Editar', [('Eliminar','bi-trash',true)], name ~ ' de ' ~ date) }}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  {% endif %}{% endcall %}
  <aside class="lt-stack">
    <article class="lt-panel lt-panel--accent">
      <div class="lt-panel__head"><i class="bi bi-bullseye"></i><h3>Objetivo de hoy</h3></div>
      <div class="lt-panel__body">
        <p class="lt-goal-today"><strong>75 min <span>/ 90 min</span></strong><b>83 %</b></p>
        <div class="lt-progress" role="img" aria-label="83 % de la meta diaria"><span style="width:83%"></span></div>
        <p class="lt-page-head__subtitle">Faltan 15 min para alcanzar tu meta diaria.</p>
        <p class="lt-page-head__subtitle">612 kcal · 8.420 pasos</p>
      </div>
    </article>
    <article class="lt-panel">
      <div class="lt-panel__head"><i class="bi bi-calendar3"></i><h3>Calendario del mes</h3>
        <div class="lt-month-nav"><button class="lt-icon-button" type="button" data-lt-static-nav aria-label="Mes anterior"><i class="bi bi-chevron-left"></i></button><span>Septiembre 2026</span><button class="lt-icon-button" type="button" data-lt-static-nav aria-label="Mes siguiente"><i class="bi bi-chevron-right"></i></button></div>
      </div>
      <div class="lt-panel__body">
        {# (minutos activos, meta de 90 min). Hoy es 10 sep; el 5 sep (60 min) corta la racha. #}
        {% set days = [(95,90),(40,90),(None,90),(90,90),(60,90),(92,90),(100,90),(90,90),(120,90),(75,90)] %}
        {{ goal_calendar('Minutos activos en septiembre de 2026', 1, 30, days, 10, 'min', 'Racha actual: 4 días cumpliendo tu meta de actividad.') }}
      </div>
    </article>
  </aside>
</section>
{{ fab('Registrar ejercicio', 'bi-activity', 'exercise-new') }}
{% call dialog('exercise-new', 'Registrar ejercicio', icon='bi-activity', sections=[('basic','Información básica','bi-activity'),('metrics','Series y distancia','bi-bar-chart'),('details','Detalles adicionales','bi-card-text')]) %}
<section class="lt-dialog__section" data-section="basic">
  <header class="lt-dialog__section-head"><h3>Información básica</h3></header>
  <div class="lt-form"><label class="lt-field lt-form--full"><span>Tipo de ejercicio *</span><select><option>Entrenamiento de fuerza</option><option>Correr</option><option>Bicicleta estática</option><option>Natación</option><option>Fútbol</option></select></label><p class="lt-page-head__subtitle lt-form--full">¿No está en la lista? <a class="lt-link" href="#/exercise-settings">Gestionar tipos</a></p><label class="lt-field "><span>Duración (min)</span><input type="number" value="15"></label><label class="lt-field "><span>Calorías</span><input type="number" value="95"></label></div>
</section>
<section class="lt-dialog__section" data-section="metrics" hidden>
  <header class="lt-dialog__section-head"><h3>Series y distancia</h3></header>
  <div class="lt-form"><label class="lt-field "><span>Series</span><input type="number" value="3"></label><label class="lt-field "><span>Reps</span><input type="number" value="6"></label><label class="lt-field "><span>Peso (kg)</span><input type="number" value="80"></label><label class="lt-field "><span>Distancia (km)</span><input type="number" value=""></label></div>
</section>
<section class="lt-dialog__section" data-section="details" hidden>
  <header class="lt-dialog__section-head"><h3>Detalles adicionales</h3></header>
  <div class="lt-form"><label class="lt-field lt-form--full"><span>Notas (opcional)</span><textarea placeholder="Sensaciones, técnica, molestias…"></textarea></label></div>
</section>
{% endcall %}
{% endcall %}
