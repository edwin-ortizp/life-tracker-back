{% from '@project/components/life-shell.html.jinja' import shell, tabs as module_tabs, header, metric, dialog, fab %}
{% call shell('exercise', 'Ejercicio', 'bi-activity') %}
{{ header('Ejercicio', 'Actividad, esfuerzo y progreso físico · Miércoles 10 sep.', 'bi-activity') }}
{{ module_tabs([('Registro diario','/exercise-daily','bi-activity'),('Estadísticas','/exercise-statistics','bi-bar-chart-line'),('Ajustes','/exercise-settings','bi-sliders')], '/exercise-daily') }}
<section class="lt-metrics">{{ metric('Duración','75 min','success') }}{{ metric('Calorías','612 kcal','warning') }}{{ metric('Pasos','8.420') }}</section>
<section class="lt-grid-main">
  <article class="lt-panel lt-panel--accent"><div class="lt-panel__head"><i class="bi bi-list-ul"></i><h3>Actividades del día</h3><small>3 registros</small></div><div class="lt-panel__body"><div class="lt-list">
    {% for icon, name, detail, time, kcal in [('bi-person-walking','Correr','5,2 km · 32 min · ritmo 6:09/km','06:40','348 kcal'),('bi-universal-access','Sentadilla con barra','4 series × 8 reps · 60 kg','18:10','140 kcal'),('bi-universal-access','Press de banca','4 series × 10 reps · 45 kg','18:35','124 kcal')] %}
    <div class="lt-list-item"><span class="lt-list-item__icon"><i class="bi {{ icon }}"></i></span><div class="lt-list-item__body"><strong>{{ name }}</strong><span>{{ detail }}</span></div><div class="lt-list-item__meta"><span class="lt-chip">{{ kcal }}</span><small>{{ time }}</small></div><button class="lt-icon-button" type="button" data-lt-static-nav aria-label="Eliminar registro"><i class="bi bi-trash"></i></button></div>
    {% endfor %}
  </div>
  <p class="lt-section-label">Meta diaria</p>
  <div class="lt-progress"><span style="width:83%"></span></div>
  <p class="lt-page-head__subtitle">75 de 90 minutos activos. Una caminata de 15 min completa la meta.</p>
  </div></article>
</section>
{{ fab('Registrar ejercicio', 'bi-activity', 'exercise-new') }}
{% call dialog('exercise-new', 'Registrar ejercicio', icon='bi-activity', sections=[('basic','Información básica','bi-activity'),('metrics','Series y distancia','bi-bar-chart'),('details','Detalles adicionales','bi-card-text')]) %}
<section class="lt-dialog__section" data-section="basic">
  <header class="lt-dialog__section-head"><h3>Información básica</h3></header>
  <div class="lt-form"><label class="lt-field lt-form--full"><span>Tipo de ejercicio *</span><select><option>Entrenamiento de fuerza</option><option>Correr</option><option>Bicicleta estática</option><option>Natación</option><option>Fútbol</option></select></label><p class="lt-page-head__subtitle lt-form--full">¿No está en la lista? <a class="lt-link" href="#/exercise-settings">Gestionar tipos</a></p><label class="lt-field "><span>Duración (min)</span><input type="number" value="15"></label><label class="lt-field "><span>Calorías</span><input type="number" value="95"></label></div>
</section>
<section class="lt-dialog__section" data-section="metrics" hidden>
  <header class="lt-dialog__section-head"><h3>Series y distancia</h3></header>
  <div class="lt-form"><label class="lt-field "><span>Series</span><input type="number" value="3"></label><label class="lt-field "><span>Reps</span><input type="number" value="6"></label><label class="lt-field "><span>Peso (kg)</span><input type="number" value="80"></label><label class="lt-field "><span>Distancia (km)</span><input type="number" value=""></label></div>
</section>
<section class="lt-dialog__section" data-section="details" hidden>
  <header class="lt-dialog__section-head"><h3>Detalles adicionales</h3></header>
  <div class="lt-form"><label class="lt-field lt-form--full"><span>Notas (opcional)</span><textarea placeholder="Sensaciones, técnica, molestias…"></textarea></label></div>
</section>
{% endcall %}
{% endcall %}
