{% from '@project/components/life-shell.html.jinja' import shell %}
{% from '@project/components/settings-nav.html.jinja' import settings_layout, section_head %}
{% call shell('settings', 'Ajustes', 'bi-gear') %}{% call settings_layout('/settings-about') %}
{{ section_head('Acerca de', 'Versiones y entorno de esta instalación.') }}
<ul class="lt-settings-box">
{% for label, value, icon in [('Life Tracker','1.14.0 · commit 421787b','bi-activity'),('Laravel','13.23.0','bi-box'),('PHP','8.3.14','bi-filetype-php'),('Livewire','4.3.4','bi-lightning'),('laravel/mcp','0.9.4','bi-robot'),('Base de datos','MySQL 8.0','bi-database'),('Entorno','production · America/Bogota','bi-hdd-network')] %}
  <li class="lt-settings-row"><span class="lt-list-item__icon"><i class="bi {{ icon }}"></i></span><div class="lt-list-item__body"><strong>{{ label }}</strong></div><code class="lt-settings-code">{{ value }}</code></li>
{% endfor %}
</ul>
<div class="lt-actions"><button class="lt-button lt-button--tonal" type="button" data-lt-static-nav><i class="bi bi-clipboard"></i> Copiar información</button></div>
{% endcall %}{% endcall %}
