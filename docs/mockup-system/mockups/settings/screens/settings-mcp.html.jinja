{% from '@project/components/life-shell.html.jinja' import shell, manage_card, dialog %}
{% from '@project/components/settings-nav.html.jinja' import settings_layout, section_head %}
{% call shell('settings', 'Ajustes', 'bi-gear') %}{% call settings_layout('/settings-mcp') %}
{{ section_head('Servidor MCP', 'Conecta tu asistente de IA (Claude, ChatGPT…) con Life Tracker mediante Model Context Protocol.') }}
<section class="lt-settings-box">
  <div class="lt-settings-row"><div class="lt-list-item__body"><strong>URL del servidor</strong><span>Agrégala como conector personalizado en tu cliente de IA.</span></div></div>
  <div class="lt-settings-row lt-settings-copy"><code class="lt-settings-code">https://lifetracker.app/mcp/life-tracker</code><button class="lt-button lt-button--tonal" type="button" data-lt-static-nav><i class="bi bi-clipboard" aria-hidden="true"></i> Copiar</button></div>
  <dl class="lt-dl lt-settings-dl"><div><dt>Nombre</dt><dd>life-tracker</dd></div><div><dt>Transporte</dt><dd>HTTP (streamable)</dd></div><div><dt>Autenticación</dt><dd>OAuth 2.1 o token lt_ai_…</dd></div><div><dt>Límite</dt><dd>60 solicitudes/min</dd></div><div><dt>Herramientas</dt><dd>81</dd></div><div><dt>Prompts · Recursos</dt><dd>0 · 0</dd></div></dl>
</section>
<ul class="lt-settings-box">
  <li class="lt-settings-row"><span class="lt-list-item__icon"><i class="bi bi-chat-square-text" aria-hidden="true"></i></span><div class="lt-list-item__body"><strong>Prompts</strong><span>El servidor no expone prompts todavía.</span></div><span class="lt-chip lt-chip--neutral">0</span></li>
  <li class="lt-settings-row"><span class="lt-list-item__icon"><i class="bi bi-box-seam" aria-hidden="true"></i></span><div class="lt-list-item__body"><strong>Recursos</strong><span>El servidor no expone recursos todavía.</span></div><span class="lt-chip lt-chip--neutral">0</span></li>
</ul>
<details class="lt-settings-box lt-settings-details"><summary><i class="bi bi-file-text" aria-hidden="true"></i> Instrucciones del servidor</summary><div class="lt-settings-details__body"><p>Life Tracker es la fuente de verdad de la vida personal del usuario: personas y relaciones, planes y lugares, salud, ánimo, energía, ejercicio, hidratación, hábitos, metas, diario, comidas y recetas, tiempo de foco, tareas, compras y vehículos.</p><p><strong>Cuándo consultar:</strong> si un dato de Life Tracker cambiaría la respuesta (una persona, un síntoma, lenguaje de continuidad como «otra vez» o «¿cómo voy con…?»).</p><p><strong>Al escribir:</strong> buscar antes de crear para no duplicar; confirmar en una línea lo que se va a guardar; borrar con delete-entry-tool solo tras confirmación.</p></div></details>
{% call(zone) manage_card('mcp-tools', 'Herramientas disponibles', 'bi-tools', count='(81 / 81)', total=81, search='Buscar herramientas', menu=[('Exportar CSV', 'bi-filetype-csv')], sort=[('module','Módulo','bi-grid'),('name','Nombre (A–Z)','bi-sort-alpha-down'),('kind','Tipo','bi-pencil-square')]) %}{% if zone == 'filters' %}
<div class="lt-popover" id="mcp-tools-filters" role="dialog" aria-labelledby="mcp-tools-filters-title" hidden><span class="lt-popover__handle" aria-hidden="true"></span>
  <div class="lt-popover__head"><h4 id="mcp-tools-filters-title">Filtros</h4><button class="lt-icon-button" type="button" data-lt-toggle="mcp-tools-filters" aria-label="Cerrar filtros"><i class="bi bi-x-lg"></i></button></div>
  <div class="lt-field"><span>Tipo</span><div class="lt-chip-row"><button class="lt-chip lt-chip--filter is-selected" type="button" data-mcp-kind="" aria-pressed="true">Todas</button><button class="lt-chip lt-chip--filter" type="button" data-mcp-kind="read" aria-pressed="false">Lectura</button><button class="lt-chip lt-chip--filter" type="button" data-mcp-kind="write" aria-pressed="false">Escritura</button></div></div>
  <label class="lt-field"><span>Módulo</span><select data-mcp-module><option value="">Todos los módulos</option><option value="Task">Tareas (8)</option><option value="Habit">Hábitos (2)</option><option value="NegativeHabit">Hábitos a evitar (2)</option><option value="Health">Salud (5)</option><option value="Context">Contexto (3)</option><option value="Relationship">Relaciones (11)</option><option value="Plan">Planes (5)</option><option value="Vehicle">Vehículos (5)</option><option value="Shopping">Compras (13)</option><option value="Meal">Comidas (10)</option><option value="Mood">Ánimo y energía (4)</option><option value="Exercise">Ejercicio (2)</option><option value="Water">Hidratación (2)</option><option value="Goal">Objetivos (4)</option><option value="Journal">Diario (2)</option><option value="Focus">Pomodoro (2)</option><option value="Common">Común (1)</option></select></label>
  <div class="lt-popover__actions"><button class="lt-button lt-button--outlined" type="button" data-mcp-clear><i class="bi bi-eraser" aria-hidden="true"></i>Limpiar</button><button class="lt-button" type="button" data-lt-toggle="mcp-tools-filters"><i class="bi bi-funnel-fill" aria-hidden="true"></i>Filtrar</button></div>
</div>
{% else %}
