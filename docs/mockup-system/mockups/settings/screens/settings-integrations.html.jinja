{% from '@project/components/life-shell.html.jinja' import shell %}
{% from '@project/components/settings-nav.html.jinja' import settings_layout, section_head %}
{% call shell('settings', 'Ajustes', 'bi-gear') %}{% call settings_layout('/settings-integrations') %}
{{ section_head('Calendario y notas', 'Sincroniza Life Tracker con tu calendario (CalDAV) y tu bóveda de Obsidian.') }}
<section class="lt-settings-box">
  <div class="lt-settings-row"><span class="lt-list-item__icon"><i class="bi bi-calendar-check"></i></span><div class="lt-list-item__body"><strong>Calendario (CalDAV)</strong><span>Tareas con fecha y cumpleaños en cualquier calendario.</span></div><span class="lt-chip lt-chip--warning">Sin uso en 30 días</span></div>
  <div class="lt-settings-row lt-settings-copy"><code class="lt-settings-code">https://lifetracker.app/dav/edwin</code><div class="lt-actions"><button class="lt-button lt-button--tonal" type="button" data-lt-static-nav><i class="bi bi-clipboard"></i> Copiar</button><button class="lt-button lt-button--danger" type="button" data-lt-static-nav>Revocar</button></div></div>
</section>
<section class="lt-settings-box">
  <div class="lt-settings-row"><span class="lt-list-item__icon"><i class="bi bi-journal-bookmark"></i></span><div class="lt-list-item__body"><strong>Obsidian</strong><span>Envía las entradas del diario a tu bóveda.</span></div><span class="lt-chip lt-chip--success">Conectado</span></div>
  <dl class="lt-dl lt-settings-dl"><div><dt>Bóveda</dt><dd>Personal</dd></div><div><dt>Carpeta</dt><dd>/Diario</dd></div><div><dt>Última sincronización</dt><dd>Ayer, 22:40</dd></div><div><dt>Entradas enviadas</dt><dd>148</dd></div></dl>
  <div class="lt-settings-row"><div class="lt-actions"><button class="lt-button lt-button--tonal" type="button" data-lt-static-nav><i class="bi bi-arrow-repeat"></i> Sincronizar</button><button class="lt-button lt-button--danger" type="button" data-lt-static-nav>Revocar</button></div></div>
</section>
{% endcall %}{% endcall %}
