{% from '@project/components/life-shell.html.jinja' import shell %}
{% from '@project/components/settings-nav.html.jinja' import settings_layout, section_head %}
{% call shell('settings', 'Ajustes', 'bi-gear') %}{% call settings_layout('/settings-profile') %}
{{ section_head('Perfil público', 'Tu nombre, correo y preferencias regionales.') }}
<section class="lt-settings-box lt-settings-form"><div class="lt-form">
  <label class="lt-field"><span>Nombre completo</span><input type="text" value="Edwin Ortiz"></label>
  <label class="lt-field"><span>Email</span><input type="email" value="edwin@lifetracker.app"></label>
  <label class="lt-field"><span>Zona horaria</span><select><option>America/Bogota (UTC−5)</option><option>America/Mexico_City (UTC−6)</option></select></label>
  <label class="lt-field"><span>Idioma</span><select><option>Español</option><option>English</option></select></label>
  <label class="lt-field"><span>Primer día de la semana</span><select><option>Lunes</option><option>Domingo</option></select></label>
</div><div class="lt-actions"><button class="lt-button" type="button" data-lt-static-nav><i class="bi bi-check2"></i> Guardar perfil</button></div></section>
<section class="lt-settings-box"><div class="lt-settings-row"><div class="lt-list-item__body"><strong>Exportar mis datos</strong><span>Un JSON con todos los módulos.</span></div><button class="lt-button lt-button--tonal" type="button" data-lt-static-nav>Exportar</button></div></section>
{% endcall %}{% endcall %}
